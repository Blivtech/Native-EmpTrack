<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#EEF2F8" android:scrollbars="none" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

        <!-- Hero -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center_horizontal"
            android:background="@drawable/bg_hero" android:paddingTop="42dp" android:paddingBottom="26dp"
            android:paddingStart="18dp" android:paddingEnd="18dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/ivBack" android:layout_width="38dp" android:layout_height="38dp"
                    android:src="@drawable/ic_arrow_back" android:tint="#FFFFFF" android:padding="9dp" android:background="@drawable/bg_icon_btn"/>
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Profile"
                    android:fontFamily="@font/satoshi_medium" android:textStyle="bold" android:textSize="16sp" android:textColor="#FFFFFF" android:layout_marginStart="12dp"/>
                <ImageView android:id="@+id/ivEdit" android:layout_width="38dp" android:layout_height="38dp"
                    android:src="@drawable/ic_edit" android:tint="#FFFFFF" android:padding="9dp" android:background="@drawable/bg_icon_btn"/>
            </LinearLayout>

            <TextView android:id="@+id/tvAvatar" android:layout_width="88dp" android:layout_height="88dp"
                android:gravity="center" android:text="S" android:textSize="34sp" android:textStyle="bold" android:fontFamily="@font/satoshi_medium"
                android:textColor="#1D4ED8" android:background="@drawable/bg_avatar_white" android:layout_marginTop="14dp"/>

            <TextView android:id="@+id/tvName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Sakthi" android:fontFamily="@font/satoshi_medium" android:textStyle="bold" android:textSize="23sp" android:textColor="#FFFFFF" android:layout_marginTop="14dp"/>
            <TextView android:id="@+id/tvRole" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Admin" android:fontFamily="@font/satoshi_medium" android:textStyle="bold" android:textSize="12.5sp" android:textColor="#FFFFFF"
                android:background="@drawable/bg_role_chip" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:layout_marginTop="8dp"/>
            <TextView android:id="@+id/tvPhone" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="@font/satoshi_medium" android:textSize="13sp" android:textColor="#CFE0FF" android:layout_marginTop="8dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Personal information"
                android:fontFamily="@font/satoshi_medium" android:textStyle="bold" android:textSize="14sp" android:textColor="#334155" android:layout_marginStart="4dp" android:layout_marginBottom="11dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_info_card">
                <LinearLayout style="@style/ProfileInfoRow">
                    <ImageView style="@style/ProfileInfoIcon" android:src="@drawable/ic_user"/>
                    <LinearLayout style="@style/ProfileInfoText"><TextView style="@style/ProfileInfoLbl" android:text="FULL NAME"/><TextView android:id="@+id/tvInfoName" style="@style/ProfileInfoVal"/></LinearLayout>
                </LinearLayout>
                <View style="@style/ProfileDivider"/>
                <LinearLayout style="@style/ProfileInfoRow">
                    <ImageView style="@style/ProfileInfoIcon" android:src="@drawable/ic_phone"/>
                    <LinearLayout style="@style/ProfileInfoText"><TextView style="@style/ProfileInfoLbl" android:text="PHONE"/><TextView android:id="@+id/tvInfoPhone" style="@style/ProfileInfoVal"/></LinearLayout>
                </LinearLayout>
                <View style="@style/ProfileDivider"/>
                <LinearLayout style="@style/ProfileInfoRow">
                    <ImageView style="@style/ProfileInfoIcon" android:src="@drawable/ic_email"/>
                    <LinearLayout style="@style/ProfileInfoText"><TextView style="@style/ProfileInfoLbl" android:text="EMAIL"/><TextView android:id="@+id/tvInfoEmail" style="@style/ProfileInfoVal"/></LinearLayout>
                </LinearLayout>
                <View style="@style/ProfileDivider"/>
                <LinearLayout style="@style/ProfileInfoRow">
                    <ImageView style="@style/ProfileInfoIcon" android:src="@drawable/ic_badge"/>
                    <LinearLayout style="@style/ProfileInfoText"><TextView style="@style/ProfileInfoLbl" android:text="USER TYPE"/><TextView android:id="@+id/tvInfoUserType" style="@style/ProfileInfoVal"/></LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton android:id="@+id/btnEditProfile"
                android:layout_width="match_parent" android:layout_height="52dp" android:text="Edit profile"
                android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold" android:fontFamily="@font/satoshi_medium"
                android:layout_marginTop="16dp" app:backgroundTint="@null" android:background="@drawable/bg_btn_primary" app:elevation="0dp"/>

            <com.google.android.material.button.MaterialButton android:id="@+id/btnChangePassword"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="52dp" android:text="Change password"
                android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold" android:fontFamily="@font/satoshi_medium"
                android:textColor="#334155" app:strokeColor="#E2E8F0" app:cornerRadius="14dp" android:layout_marginTop="10dp"/>

            <com.google.android.material.button.MaterialButton android:id="@+id/btnLogout"
                android:layout_width="match_parent" android:layout_height="52dp" android:text="Log out"
                android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold" android:fontFamily="@font/satoshi_medium"
                android:textColor="#DC2626" app:backgroundTint="#FEE2E2" app:cornerRadius="14dp" app:icon="@drawable/ic_logout" app:iconTint="#DC2626" app:iconGravity="textStart"
                android:layout_marginTop="10dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="EmpTrack v1.0 · © 2026 BlivTech"
                android:gravity="center" android:textColor="#94A3B8" android:textSize="11.5sp" android:fontFamily="@font/satoshi_medium" android:layout_marginTop="18dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
