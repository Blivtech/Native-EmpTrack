<?xml version="1.0" encoding="utf-8"?>
<!-- Compact module tile — matches HTML mock. IDs unchanged so DashboardAdapter works as-is:
     iconHolder (bg tinted via item.iconBgColor) · icon (glyph tinted via item.iconColor) · title -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_margin="6dp"
    android:paddingVertical="16dp"
    android:paddingHorizontal="6dp"
    android:background="@drawable/bg_module_card">

    <FrameLayout
        android:id="@+id/iconHolder"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_module_chip">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_nav_home" />
    </FrameLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Work-Based Pay"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:fontFamily="@font/satoshi_medium"
        android:textColor="#0F172A"
        android:layout_marginTop="10dp" />
</LinearLayout>