<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog">

    <!-- Handle -->
    <View
        android:layout_width="@dimen/bottom_sheet_handle_width"
        android:layout_height="@dimen/bottom_sheet_handle_height"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/margin_md"
        android:background="@drawable/bg_sheet_handle"/>

    <TextView
        android:id="@+id/tvSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_lg"
        android:gravity="center"
        android:text="Add Product Rate"
        android:fontFamily="@font/satoshi_bold"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_heading"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Product • Work • Rate • Unit"
        android:textColor="@color/text_secondary"
        android:fontFamily="@font/satoshi_medium"
        android:textSize="@dimen/text_small"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/margin_lg"
        android:background="@color/divider"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_lg">
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Product Name"
                app:placeholderText="e.g. Shirt, Pant, Jacket"
                app:boxStrokeColor="@color/primary"
                app:boxCornerRadiusTopStart="@dimen/radius_lg"
                app:boxCornerRadiusTopEnd="@dimen/radius_lg"
                app:boxCornerRadiusBottomStart="@dimen/radius_lg"
                app:boxCornerRadiusBottomEnd="@dimen/radius_lg">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etProductName"
                    android:fontFamily="@font/satoshi_medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"/>

            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_md"
                android:hint="Work Name"
                app:placeholderText="e.g. Coil Winding, Stitching"
                app:boxStrokeColor="@color/primary"
                app:boxCornerRadiusTopStart="@dimen/radius_lg"
                app:boxCornerRadiusTopEnd="@dimen/radius_lg"
                app:boxCornerRadiusBottomStart="@dimen/radius_lg"
                app:boxCornerRadiusBottomEnd="@dimen/radius_lg">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etWorkName"
                    android:fontFamily="@font/satoshi_medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"/>

            </com.google.android.material.textfield.TextInputLayout>            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_md"
                android:hint="Rate per Unit"
                app:prefixText="₹ "
                app:prefixTextColor="@color/primary"
                app:boxStrokeColor="@color/primary"
                app:boxCornerRadiusTopStart="@dimen/radius_lg"
                app:boxCornerRadiusTopEnd="@dimen/radius_lg"
                app:boxCornerRadiusBottomStart="@dimen/radius_lg"
                app:boxCornerRadiusBottomEnd="@dimen/radius_lg">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:fontFamily="@font/satoshi_bold"

                    android:textStyle="bold"
                    android:textSize="@dimen/text_heading"/>

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_lg"
                android:text="Unit"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_sm"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutUnitChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="2dp"/>

            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_lg"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="New Unit"
                    app:placeholderText="e.g. Yard, Roll"
                    app:boxStrokeColor="@color/primary"
                    app:boxCornerRadiusTopStart="@dimen/radius_lg"
                    app:boxCornerRadiusTopEnd="@dimen/radius_lg"
                    app:boxCornerRadiusBottomStart="@dimen/radius_lg"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_lg">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCustomUnit"
                        android:fontFamily="@font/satoshi_medium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"/>

                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginStart="@dimen/margin_sm"
                    android:background="@drawable/bg_button_primary"
                    android:text="+ Add"
                    android:fontFamily="@font/satoshi_bold"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    app:backgroundTint="@null"
                    app:cornerRadius="@dimen/radius_lg"/>

            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveProduct"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/margin_xl"
                android:layout_marginBottom="@dimen/margin_lg"
                android:background="@drawable/bg_button_primary"
                android:text="Save Product Rate"
                android:fontFamily="@font/satoshi_bold"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="@dimen/text_body"
                app:backgroundTint="@null"
                app:cornerRadius="@dimen/radius_lg"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>