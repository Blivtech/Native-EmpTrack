<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F9">

    <!-- ✅ Topbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#004D40">

        <!-- Title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="13dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="#FFFFFF"
                android:padding="5dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Monthly Report"
                    android:fontFamily="@font/satoshi_medium"
                    android:textSize="@dimen/text_caption_lg"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:id="@+id/tvCompanyName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/satoshi_medium"
                    android:textSize="@dimen/text_caption_small"                    android:textColor="#99FFFFFF"
                    android:layout_marginTop="1dp"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/img_download"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:src="@android:drawable/ic_menu_save"
                android:tint="#FFFFFF"
                android:background="@drawable/bg_circle_white15"
                android:padding="5dp"/>
        </LinearLayout>

        <!-- Month navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/btnPrevMonth"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_media_previous"
                android:tint="#CCffffff"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tvMonthLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:fontFamily="@font/satoshi_medium"
                android:textSize="@dimen/text_caption_lg"                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

            <ImageView
                android:id="@+id/btnNextMonth"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_media_next"
                android:tint="#CCffffff"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- Summary strip -->
        <LinearLayout
            android:id="@+id/layoutSummaryStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#013328"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">
                <TextView
                    android:id="@+id/tvSumPresent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:fontFamily="@font/satoshi_medium"
                    android:textSize="@dimen/text_caption_md"                     android:textStyle="bold"
                    android:textColor="#69F0AE"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Present"
                    android:fontFamily="@font/satoshi_medium"
                    android:textSize="@dimen/text_caption_md"                       android:textColor="#88FFFFFF"
                    android:layout_marginTop="1dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">
                <TextView
                    android:id="@+id/tvSumAbsent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:fontFamily="@font/satoshi_medium"
                    android:textSize="@dimen/text_caption_md"                   android:textStyle="bold"
                    android:textColor="#FF8A80"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Leave"
                    android:fontFamily="@font/satoshi_medium"
                    android:textSize="@dimen/text_caption_md"                       android:textColor="#88FFFFFF"
                    android:layout_marginTop="1dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">
                <TextView
                    android:id="@+id/tvSumHoliday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:fontFamily="@font/satoshi_medium"
                    android:textSize="@dimen/text_caption_md"                       android:textStyle="bold"
                    android:textColor="#CE93D8"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Holiday"
                    android:fontFamily="@font/satoshi_medium"
                    android:textSize="@dimen/text_caption_md"                       android:textColor="#88FFFFFF"
                    android:layout_marginTop="1dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">
                <TextView
                    android:id="@+id/tvSumWeekOff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:fontFamily="@font/satoshi_medium"
                    android:textSize="@dimen/text_caption_md"                    android:textStyle="bold"
                    android:textColor="#B0BEC5"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Week Off"
                    android:fontFamily="@font/satoshi_medium"
                    android:textSize="@dimen/text_caption_md"                       android:textColor="#88FFFFFF"
                    android:layout_marginTop="1dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_circle_white15">

            <TextView
                android:id="@+id/tabOverall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Overall"
                android:fontFamily="@font/satoshi_medium"
                android:textSize="@dimen/text_caption_md"                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:padding="9dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tabShiftWise"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Shift Wise"
                android:fontFamily="@font/satoshi_medium"
                android:textSize="@dimen/text_caption_md"                   android:textStyle="bold"
                android:textColor="#88FFFFFF"
                android:gravity="center"
                android:padding="9dp"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Progress bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:indeterminate="true"
        android:indeterminateTint="#004D40"
        android:visibility="gone"/>

    <!-- Shift chips — shown in shift wise mode -->
    <HorizontalScrollView
        android:id="@+id/scrollShiftChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/layoutShiftChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:paddingStart="11dp"/>
    </HorizontalScrollView>

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="11dp">

            <!-- Shimmer -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:shimmer_duration="1000"
                app:shimmer_base_color="#F0F0F0"
                app:shimmer_highlight_color="#FFFFFF"
                android:visibility="gone">
                <include layout="@layout/layout_shimmer_list"/>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <!-- Table wrapper -->
            <LinearLayout
                android:id="@+id/layoutTable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:layout_marginBottom="8dp"
                android:visibility="visible">

                <!-- Table header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#F8F9FB"
                    android:padding="8dp"
                    android:paddingStart="11dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2.5"
                        android:text="EMPLOYEE"
                        android:fontFamily="@font/satoshi_medium"
                        android:textSize="@dimen/text_caption_small"                           android:textStyle="bold"
                        android:textColor="#BDBDBD"
                        android:letterSpacing="0.05"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="P"
                        android:fontFamily="@font/satoshi_medium"
                        android:textSize="@dimen/text_caption_small"                          android:textStyle="bold"
                        android:textColor="#27500A"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="L"
                        android:fontFamily="@font/satoshi_medium"
                        android:textSize="@dimen/text_caption_small"                          android:textStyle="bold"
                        android:textColor="#E24B4A"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="H"
                        android:fontFamily="@font/satoshi_medium"
                        android:textSize="@dimen/text_caption_small"                          android:textStyle="bold"
                        android:textColor="#3C3489"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="WO"
                        android:fontFamily="@font/satoshi_medium"
                        android:textSize="@dimen/text_caption_small"                          android:textStyle="bold"
                        android:textColor="#9E9E9E"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total"
                        android:fontFamily="@font/satoshi_medium"
                        android:textSize="@dimen/text_caption_small"                          android:textStyle="bold"
                        android:textColor="#1565C0"
                        android:gravity="center"/>
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EBEBEB"/>

                <!-- Table rows — dynamic -->
                <LinearLayout
                    android:id="@+id/layoutTableRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>

            <!-- Hint -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#E6F1FB"
                android:padding="9dp"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@android:drawable/ic_dialog_info"
                    android:tint="#0C447C"
                    android:layout_marginEnd="7dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap any count to see dates"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:textColor="#0C447C"/>
            </LinearLayout>

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="40dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No data for this month"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#BDBDBD"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>


</LinearLayout>