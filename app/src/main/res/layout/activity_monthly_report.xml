<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF2F8"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_green"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="42dp"
        android:paddingEnd="16dp"
        android:paddingBottom="44dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_icon_btn"
                android:clickable="true"
                android:focusable="true"
                android:padding="9dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="#FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/satoshi_medium"
                    android:text="Monthly Report"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCompanyName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/satoshi_medium"
                    android:textColor="#CDEBD8"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/img_download"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_icon_btn"
                android:clickable="true"
                android:focusable="true"
                android:padding="9dp"
                android:src="@drawable/ic_save"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnPrevMonth"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_navbtn"
                android:clickable="true"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_skip_prev"
                android:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvMonthLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/satoshi_medium"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnNextMonth"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_navbtn"
                android:clickable="true"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_skip_next"
                android:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
    <!--  Summary tiles (overlap header)  -->
    <LinearLayout
        android:id="@+id/layoutSummaryStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="-30dp"
        android:layout_marginEnd="14dp"
        android:orientation="horizontal">

        <LinearLayout style="@style/MonTile">

            <TextView
                android:id="@+id/tvSumPresent"
                style="@style/MonTileNum"
                android:textColor="#16A34A" />

            <TextView
                style="@style/MonTileLbl"
                android:text="Present" />
        </LinearLayout>

        <View
            android:layout_width="9dp"
            android:layout_height="1dp" />

        <LinearLayout style="@style/MonTile">

            <TextView
                android:id="@+id/tvSumAbsent"
                style="@style/MonTileNum"
                android:textColor="#DC2626" />

            <TextView
                style="@style/MonTileLbl"
                android:text="Leave" />
        </LinearLayout>

        <View
            android:layout_width="9dp"
            android:layout_height="1dp" />

        <LinearLayout style="@style/MonTile">

            <TextView
                android:id="@+id/tvSumHoliday"
                style="@style/MonTileNum"
                android:textColor="#7C3AED" />

            <TextView
                style="@style/MonTileLbl"
                android:text="Holiday" />
        </LinearLayout>

        <View
            android:layout_width="9dp"
            android:layout_height="1dp" />

        <LinearLayout style="@style/MonTile">

            <TextView
                android:id="@+id/tvSumWeekOff"
                style="@style/MonTileNum"
                android:textColor="#334155" />

            <TextView
                style="@style/MonTileLbl"
                android:text="Week Off" />
        </LinearLayout>
    </LinearLayout>
    <!--  Tabs (segmented)  -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_tabbar"
        android:orientation="horizontal"
        android:padding="5dp">

        <TextView
            android:id="@+id/tabOverall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_selector"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/satoshi_medium"
            android:gravity="center"
            android:padding="11dp"
            android:text="Overall"
            android:textColor="@color/mon_tab_text"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabShiftWise"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_selector"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/satoshi_medium"
            android:gravity="center"
            android:padding="11dp"
            android:text="Shift Wise"
            android:textColor="@color/mon_tab_text"
            android:textSize="14.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="#00897B"
        android:visibility="gone" />
    <!--  Shift chips  -->
    <HorizontalScrollView
        android:id="@+id/scrollShiftChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/layoutShiftChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:paddingStart="14dp" />
    </HorizontalScrollView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:shimmer_base_color="#F0F0F0"
                app:shimmer_duration="1000"
                app:shimmer_highlight_color="#FFFFFF">

                <include layout="@layout/layout_shimmer_list" />
            </com.facebook.shimmer.ShimmerFrameLayout>

            <LinearLayout
                android:id="@+id/layoutTable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_table_card"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_thead"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2.5"
                        android:fontFamily="@font/satoshi_medium"
                        android:text="EMPLOYEE"
                        android:textColor="#94A3B8"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/MonHeadCol"
                        android:text="P"
                        android:textColor="#16A34A" />

                    <TextView
                        style="@style/MonHeadCol"
                        android:text="L"
                        android:textColor="#DC2626" />

                    <TextView
                        style="@style/MonHeadCol"
                        android:text="H"
                        android:textColor="#7C3AED" />

                    <TextView
                        style="@style/MonHeadCol"
                        android:text="WO"
                        android:textColor="#94A3B8" />

                    <TextView
                        style="@style/MonHeadCol"
                        android:text="Total"
                        android:textColor="#2563EB" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutTableRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_info"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_info_dot"
                    android:gravity="center"
                    android:text="i"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/satoshi_medium"
                    android:text="Tap any count to see dates"
                    android:textColor="#1E3A8A"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="40dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/satoshi_medium"
                    android:text="No data for this month"
                    android:textColor="#94A3B8"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>