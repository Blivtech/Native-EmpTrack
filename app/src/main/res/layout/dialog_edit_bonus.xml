<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#085041"
        android:padding="14dp">

        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#FFFFFF"
            android:layout_marginEnd="10dp"
            android:clickable="true"
            android:focusable="true"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit bonus"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/tvEmpInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="9sp"
                android:textColor="#CCFFFFFF"
                android:layout_marginTop="1dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Form -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Date -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DATE"
            android:textSize="8sp"
            android:textStyle="bold"
            android:textColor="#9E9E9E"
            android:letterSpacing="0.06"
            android:layout_marginBottom="5dp"/>

        <LinearLayout
            android:id="@+id/layoutDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_edit_field_normal"
            android:padding="11dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@android:drawable/ic_menu_my_calendar"
                android:tint="#085041"
                android:layout_marginEnd="7dp"/>

            <TextView
                android:id="@+id/tvSelectedDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#212121"/>

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@android:drawable/arrow_down_float"
                android:tint="#9E9E9E"/>
        </LinearLayout>

        <!-- Bonus Type -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BONUS TYPE"
            android:textSize="8sp"
            android:textStyle="bold"
            android:textColor="#9E9E9E"
            android:letterSpacing="0.06"
            android:layout_marginBottom="5dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/chipFestival"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Festival"
                android:textSize="9sp"
                android:textStyle="bold"
                android:padding="9dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_edit_field_normal"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/chipPerformance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Performance"
                android:textSize="9sp"
                android:textStyle="bold"
                android:padding="9dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_edit_field_normal"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/chipAttendance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Attendance"
                android:textSize="9sp"
                android:textStyle="bold"
                android:padding="9dp"
                android:background="@drawable/bg_edit_field_normal"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- Amount -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AMOUNT"
            android:textSize="8sp"
            android:textStyle="bold"
            android:textColor="#9E9E9E"
            android:letterSpacing="0.06"
            android:layout_marginBottom="5dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_edit_field_normal"
            android:padding="11dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#085041"
                android:layout_marginEnd="6dp"/>

            <EditText
                android:id="@+id/etAmount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:inputType="numberDecimal"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:hint="0.00"
                android:padding="0dp"/>
        </LinearLayout>

        <!-- Remarks -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REMARKS"
            android:textSize="8sp"
            android:textStyle="bold"
            android:textColor="#9E9E9E"
            android:letterSpacing="0.06"
            android:layout_marginBottom="5dp"/>

        <EditText
            android:id="@+id/etRemarks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:gravity="top"
            android:background="@drawable/bg_edit_field_normal"
            android:padding="11dp"
            android:textSize="10sp"
            android:textColor="#424242"
            android:hint="Reason / notes..."
            android:layout_marginBottom="16dp"/>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#757575"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="#D3D1C7"
                app:cornerRadius="10dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="Save changes"
                android:textAllCaps="false"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="#085041"
                app:cornerRadius="10dp"/>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>