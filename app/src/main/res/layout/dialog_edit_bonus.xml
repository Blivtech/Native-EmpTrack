<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_sheet">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:background="@drawable/bg_sheet_head" android:padding="18dp">
        <ImageView android:id="@+id/ivClose" android:layout_width="38dp" android:layout_height="38dp"
            android:src="@drawable/ic_close" android:tint="#FFFFFF" android:padding="10dp" android:background="@drawable/bg_icon_btn" android:layout_marginEnd="13dp" android:clickable="true" android:focusable="true"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Edit bonus"
                android:fontFamily="@font/satoshi_medium" android:textSize="18sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
            <TextView android:id="@+id/tvEmpInfo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="@font/satoshi_medium" android:textSize="12.5sp" android:textStyle="bold" android:textColor="#B6E3D6" android:layout_marginTop="1dp"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">

        <TextView style="@style/BnLabel" android:text="DATE"/>
        <LinearLayout android:id="@+id/layoutDate" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_field" android:padding="14dp" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_calendar" android:tint="#94A3B8" android:layout_marginEnd="10dp"/>
            <TextView android:id="@+id/tvSelectedDate" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:fontFamily="@font/satoshi_medium" android:textSize="15sp" android:textStyle="bold" android:textColor="#0F172A"/>
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_chevron_down" android:tint="#94A3B8"/>
        </LinearLayout>

        <TextView style="@style/BnLabel" android:text="BONUS TYPE"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/chipFestival" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:gravity="center" android:text="Festival" android:fontFamily="@font/satoshi_medium" android:textStyle="bold" android:textSize="13sp"
                android:padding="12dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_edit_field_normal" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/chipPerformance" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:gravity="center" android:text="Performance" android:fontFamily="@font/satoshi_medium" android:textStyle="bold" android:textSize="13sp"
                android:padding="12dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_edit_field_normal" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/chipAttendance" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:gravity="center" android:text="Attendance" android:fontFamily="@font/satoshi_medium" android:textStyle="bold" android:textSize="13sp"
                android:padding="12dp" android:background="@drawable/bg_edit_field_normal" android:clickable="true" android:focusable="true"/>
        </LinearLayout>

        <TextView style="@style/BnLabel" android:text="AMOUNT"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:background="@drawable/bg_field" android:paddingStart="14dp" android:paddingEnd="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹"
                android:fontFamily="@font/satoshi_medium" android:textSize="15sp" android:textStyle="bold" android:textColor="#94A3B8" android:layout_marginEnd="8dp"/>
            <EditText android:id="@+id/etAmount" android:layout_width="match_parent" android:layout_height="52dp"
                android:background="@null" android:inputType="numberDecimal" android:fontFamily="@font/satoshi_medium"
                android:textSize="15sp" android:textStyle="bold" android:textColor="#0F172A" android:textColorHint="#CBD5E1" android:hint="0.00"/>
        </LinearLayout>

        <TextView style="@style/BnLabel" android:text="REMARKS"/>
        <EditText android:id="@+id/etRemarks" android:layout_width="match_parent" android:layout_height="74dp"
            android:gravity="top|start" android:background="@drawable/bg_field" android:padding="14dp"
            android:fontFamily="@font/satoshi_medium" android:textSize="14.5sp" android:textColor="#0F172A" android:textColorHint="#94A3B8"
            android:hint="Reason / notes…" android:inputType="textMultiLine|textCapSentences"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp" android:paddingBottom="6dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:layout_marginEnd="10dp"
                android:text="Cancel" android:textAllCaps="false" android:textSize="14.5sp" android:textStyle="bold" android:fontFamily="@font/satoshi_medium"
                android:textColor="#475569" app:strokeColor="#E2E8F0" app:cornerRadius="13dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSave"
                android:layout_width="0dp" android:layout_weight="1.3" android:layout_height="52dp"
                android:text="Save changes" android:textAllCaps="false" android:textSize="14.5sp" android:textStyle="bold" android:fontFamily="@font/satoshi_medium"
                app:backgroundTint="@null" android:background="@drawable/bg_btn_teal" app:cornerRadius="13dp" app:elevation="0dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
