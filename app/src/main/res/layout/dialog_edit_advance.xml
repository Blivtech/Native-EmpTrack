<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#633806"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="10dp"
            android:clickable="true"
            android:focusable="true"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/satoshi_medium"
                android:text="Edit advance"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_caption_md"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmpInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/satoshi_medium"
                android:textColor="#CCFFFFFF"
                android:textSize="@dimen/text_caption_small" />
        </LinearLayout>
    </LinearLayout>

    <!-- Form -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Date -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/satoshi_medium"
            android:letterSpacing="0.06"
            android:text="Date"
            android:textColor="#9E9E9E"
            android:textSize="@dimen/text_caption_small"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_edit_field_focused"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="11dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="7dp"
                android:src="@android:drawable/ic_menu_my_calendar"
                android:tint="#633806" />

            <TextView
                android:id="@+id/tvSelectedDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/satoshi_medium"
                android:textColor="#212121"
                android:textSize="@dimen/text_caption_small"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@android:drawable/arrow_down_float"
                android:tint="#9E9E9E" />
        </LinearLayout>

        <!-- Amount -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/satoshi_medium"
            android:letterSpacing="0.06"
            android:text="Amount"
            android:textColor="#9E9E9E"
            android:textSize="@dimen/text_caption_small"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_edit_field_normal"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="11dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:fontFamily="@font/satoshi_medium"
                android:text="₹"
                android:textColor="#633806"
                android:textSize="@dimen/text_caption_small"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAmount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/satoshi_medium"
                android:hint="0.00"
                android:inputType="numberDecimal"
                android:padding="0dp"
                android:textColor="#212121"
                android:textSize="@dimen/text_caption_small"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Remarks -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/satoshi_medium"
            android:letterSpacing="0.06"
            android:text="Remarks"
            android:textColor="#9E9E9E"
            android:textSize="@dimen/text_caption_small"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etRemarks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_edit_field_normal"
            android:fontFamily="@font/satoshi_medium"
            android:gravity="top"
            android:hint="Reason / notes..."
            android:minLines="2"
            android:padding="11dp"
            android:textColor="#424242"
            android:textSize="@dimen/text_caption_small" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/satoshi_medium"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="#757575"
                android:textSize="@dimen/text_caption_small"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:strokeColor="#D3D1C7" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:fontFamily="@font/satoshi_medium"
                android:text="Save changes"
                android:textAllCaps="false"
                android:textSize="@dimen/text_caption_small"
                android:textStyle="bold"
                app:backgroundTint="#633806"
                app:cornerRadius="10dp" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>