<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/padding_md"
    android:paddingEnd="@dimen/padding_md"
    android:paddingTop="@dimen/padding_sm"
    android:paddingBottom="@dimen/padding_sm"
    android:layout_marginBottom="@dimen/margin_xs">

    <!-- Product + Work -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSumProduct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_caption_vs"
            android:fontFamily="@font/satoshi_bold"/>

        <TextView
            android:id="@+id/tvSumWork"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/text_secondary"
            android:textSize="8sp"
            android:fontFamily="@font/satoshi_regular"/>

    </LinearLayout>

    <!-- Quantity -->
    <TextView
        android:id="@+id/tvSumQty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_caption_vs"
        android:fontFamily="@font/satoshi_medium"/>

    <!-- Rate -->
    <TextView
        android:id="@+id/tvSumRate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.8"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_caption_vs"
        android:fontFamily="@font/satoshi_medium"/>

    <!-- Amount -->
    <TextView
        android:id="@+id/tvSumAmount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:gravity="end"
        android:textColor="@color/green_dark"
        android:textSize="@dimen/text_caption_vs"
        android:fontFamily="@font/satoshi_bold"/>

</LinearLayout>