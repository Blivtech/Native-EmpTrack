<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="@dimen/padding_md"
    android:background="?attr/selectableItemBackground"
    android:layout_marginBottom="@dimen/margin_xs">

    <!-- Status Dot -->
    <View
        android:id="@+id/viewDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="@dimen/margin_md"
        android:background="@drawable/bg_circle_blue"/>

    <!-- Product Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvProductName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_caption_small"
            android:fontFamily="@font/satoshi_bold"/>

        <TextView
            android:id="@+id/tvWorkName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption_vs"
            android:fontFamily="@font/satoshi_regular"/>

    </LinearLayout>

    <!-- Selected Icon -->
    <ImageView
        android:id="@+id/ivCheck"
        android:layout_width="@dimen/icon_sm"
        android:layout_height="@dimen/icon_sm"
        android:src="@android:drawable/checkbox_on_background"
        android:tint="@color/primary"
        android:visibility="gone"/>

</LinearLayout>