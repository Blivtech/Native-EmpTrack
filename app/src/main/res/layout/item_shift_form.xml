<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_shift_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="13dp">

    <TextView
        android:id="@+id/tvShiftNumber"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_shift_num"
        android:fontFamily="@font/satoshi_medium"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvShiftName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/satoshi_medium"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvShiftTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/satoshi_medium"
            android:textColor="#64748B"
            android:textSize="12.5sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivDeleteShift"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_shift_del"
        android:padding="9dp"
        android:src="@drawable/ic_delete"
        android:tint="#DC2626" />
</LinearLayout>