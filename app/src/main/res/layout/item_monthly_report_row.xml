<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp"
    android:paddingStart="11dp"
    android:background="?attr/selectableItemBackground">

    <!-- Employee name + code -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2.5"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvEmpName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="#212121"/>

        <TextView
            android:id="@+id/tvEmpCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="7sp"
            android:textColor="#BDBDBD"
            android:layout_marginTop="1dp"/>
    </LinearLayout>

    <!-- Present — tappable -->
    <TextView
        android:id="@+id/tvPresent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="#27500A"
        android:background="@drawable/bg_card_working"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_marginEnd="3dp"
        android:clickable="true"
        android:focusable="true"/>

    <!-- Absent — tappable -->
    <TextView
        android:id="@+id/tvAbsent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="#E24B4A"
        android:background="@drawable/bg_badge_red_light"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_marginEnd="3dp"
        android:clickable="true"
        android:focusable="true"/>

    <!-- Holiday — tappable -->
    <TextView
        android:id="@+id/tvHoliday"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="#3C3489"
        android:background="@drawable/bg_badge_purple"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_marginEnd="3dp"
        android:clickable="true"
        android:focusable="true"/>

    <TextView
        android:id="@+id/tvWeekOff"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="#9E9E9E"
        android:background="@drawable/bg_badge_grey"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_marginEnd="3dp"
        android:clickable="true"
        android:focusable="true"/>

    <TextView
        android:id="@+id/tvTotal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="#1565C0"/>

</LinearLayout>