<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row_divider"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvEmpName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/satoshi_medium"
            android:textColor="#0F172A"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEmpCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/satoshi_medium"
            android:textColor="#94A3B8"
            android:textSize="12.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvP"
        style="@style/WkPill"
        android:background="@drawable/bg_pill_p"
        android:textColor="#16A34A" />

    <TextView
        android:id="@+id/tvL"
        style="@style/WkPill"
        android:background="@drawable/bg_pill_l"
        android:textColor="#DC2626" />

    <TextView
        android:id="@+id/tvH"
        style="@style/WkPill"
        android:background="@drawable/bg_pill_h"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/tvWO"
        style="@style/WkPill"
        android:background="@drawable/bg_pill_wo"
        android:textColor="#94A3B8" />

    <TextView
        android:id="@+id/tvTotal"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/satoshi_medium"
        android:gravity="center"
        android:textColor="#2563EB"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>