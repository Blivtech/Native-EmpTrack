<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F9">

    <!-- Topbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#283593">

        <!-- Title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="13dp"
            android:paddingBottom="10dp">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:src="@drawable/ic_nav_home"
                android:tint="#FFFFFF"
                android:background="@drawable/bg_circle_white18"
                android:padding="5dp"
                android:layout_marginEnd="8dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Weekly Report"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:id="@+id/tvCompanyName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="9sp"
                    android:textColor="#99FFFFFF"
                    android:layout_marginTop="1dp"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/btnDownload"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:src="@android:drawable/ic_menu_save"
                android:tint="#FFFFFF"
                android:background="@drawable/bg_circle_white15"
                android:padding="5dp"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- Week navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/btnPrevWeek"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_media_previous"
                android:tint="#CCffffff"
                android:clickable="true"
                android:focusable="true"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvWeekLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:id="@+id/tvWeekSubLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="8sp"
                    android:textColor="#88FFFFFF"
                    android:layout_marginTop="1dp"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/btnNextWeek"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_media_next"
                android:tint="#CCffffff"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- Overall summary strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#0C447C">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="9dp">
                <TextView
                    android:id="@+id/tvTotalPresent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#69F0AE"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRESENT"
                    android:textSize="7sp"
                    android:textStyle="bold"
                    android:textColor="#88FFFFFF"
                    android:letterSpacing="0.06"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <View android:layout_width="0.5dp" android:layout_height="match_parent"
                android:background="#FFFFFF22"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="9dp"
                android:background="#0A3B6E">
                <TextView
                    android:id="@+id/tvTotalAbsent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#FF8A80"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ABSENT"
                    android:textSize="7sp"
                    android:textStyle="bold"
                    android:textColor="#88FFFFFF"
                    android:letterSpacing="0.06"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <View android:layout_width="0.5dp" android:layout_height="match_parent"
                android:background="#FFFFFF22"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="9dp">
                <TextView
                    android:id="@+id/tvWorkDays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#FFD54F"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WORK DAYS"
                    android:textSize="7sp"
                    android:textStyle="bold"
                    android:textColor="#88FFFFFF"
                    android:letterSpacing="0.06"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Progress bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:indeterminate="true"
        android:indeterminateTint="#1565C0"
        android:visibility="gone"/>

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="11dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SHIFT WISE WEEKLY SUMMARY"
                android:textSize="7sp"
                android:textStyle="bold"
                android:textColor="#BDBDBD"
                android:letterSpacing="0.07"
                android:layout_marginBottom="8dp"/>

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="40dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No data for this week"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#9E9E9E"/>
            </LinearLayout>

            <!-- Shift cards (dynamic) -->
            <LinearLayout
                android:id="@+id/layoutShiftCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <View android:layout_width="match_parent" android:layout_height="60dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- Download bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:padding="9dp"
        android:elevation="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_badge_red_light"
            android:layout_marginEnd="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PDF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#C62828"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_badge_green_light"
            android:layout_marginEnd="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Excel"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#1B5E20"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_badge_blue">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Share"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#0C447C"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>