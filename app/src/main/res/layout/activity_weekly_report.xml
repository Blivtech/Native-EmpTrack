<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF2F8"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_indigo"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="42dp"
        android:paddingEnd="16dp"
        android:paddingBottom="44dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_icon_btn"
                android:padding="9dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="#FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/satoshi_medium"
                    android:text="Weekly Report"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCompanyName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/satoshi_medium"
                    android:textColor="#C4C2F0"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnDownload"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_icon_btn"
                android:clickable="true"
                android:focusable="true"
                android:padding="9dp"
                android:src="@drawable/ic_save"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <!-- Week navigator (range tappable → edit start/end) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnPrevWeek"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_navbtn"
                android:clickable="true"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_skip_prev"
                android:tint="#FFFFFF" />

            <LinearLayout
                android:id="@+id/layoutWeekRange"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWeekLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/satoshi_medium"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvWeekSubLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/satoshi_medium"
                        android:textColor="#C4C2F0"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_edit"
                        android:tint="#C4C2F0" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/btnNextWeek"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_navbtn"
                android:clickable="true"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_skip_next"
                android:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Summary tiles (overlap header) -->
    <LinearLayout
        android:id="@+id/layoutSummaryStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="-30dp"
        android:layout_marginEnd="14dp"
        android:orientation="horizontal">

        <LinearLayout style="@style/WkTile">

            <TextView
                android:id="@+id/tvPresent"
                style="@style/WkTileNum"
                android:textColor="#16A34A" />

            <TextView
                style="@style/WkTileLbl"
                android:text="Present" />
        </LinearLayout>

        <View
            android:layout_width="9dp"
            android:layout_height="1dp" />

        <LinearLayout style="@style/WkTile">

            <TextView
                android:id="@+id/tvLeave"
                style="@style/WkTileNum"
                android:textColor="#DC2626" />

            <TextView
                style="@style/WkTileLbl"
                android:text="Leave" />
        </LinearLayout>

        <View
            android:layout_width="9dp"
            android:layout_height="1dp" />

        <LinearLayout style="@style/WkTile">

            <TextView
                android:id="@+id/tvHoliday"
                style="@style/WkTileNum"
                android:textColor="#7C3AED" />

            <TextView
                style="@style/WkTileLbl"
                android:text="Holiday" />
        </LinearLayout>

        <View
            android:layout_width="9dp"
            android:layout_height="1dp" />

        <LinearLayout style="@style/WkTile">

            <TextView
                android:id="@+id/tvWeekOff"
                style="@style/WkTileNum"
                android:textColor="#334155" />

            <TextView
                style="@style/WkTileLbl"
                android:text="Week Off" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tabs (segmented) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_tabbar"
        android:orientation="horizontal"
        android:padding="5dp">

        <TextView
            android:id="@+id/tabOverall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_selector"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/satoshi_medium"
            android:gravity="center"
            android:padding="11dp"
            android:text="Overall"
            android:textColor="@color/wk_tab_text"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabShiftWise"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_selector"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/satoshi_medium"
            android:gravity="center"
            android:padding="11dp"
            android:text="Shift Wise"
            android:textColor="@color/wk_tab_text"
            android:textSize="14.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Shift chips -->
    <HorizontalScrollView
        android:id="@+id/scrollShiftChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/layoutShiftChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:paddingStart="14dp" />
    </HorizontalScrollView>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:shimmer_base_color="#F0F0F0"
                app:shimmer_duration="1000"
                app:shimmer_highlight_color="#FFFFFF">

                <include layout="@layout/layout_shimmer_list" />
            </com.facebook.shimmer.ShimmerFrameLayout>

            <LinearLayout
                android:id="@+id/layoutTable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_table_card"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_thead"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2.5"
                        android:fontFamily="@font/satoshi_medium"
                        android:text="EMPLOYEE"
                        android:textColor="#94A3B8"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/WkHeadCol"
                        android:text="P"
                        android:textColor="#16A34A" />

                    <TextView
                        style="@style/WkHeadCol"
                        android:text="L"
                        android:textColor="#DC2626" />

                    <TextView
                        style="@style/WkHeadCol"
                        android:text="H"
                        android:textColor="#7C3AED" />

                    <TextView
                        style="@style/WkHeadCol"
                        android:text="WO"
                        android:textColor="#94A3B8" />

                    <TextView
                        style="@style/WkHeadCol"
                        android:text="Total"
                        android:textColor="#2563EB" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvWeeklyRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <LinearLayout
                    android:id="@+id/layoutEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="30dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/satoshi_medium"
                        android:text="No data for this week"
                        android:textColor="#94A3B8"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_info"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_info_dot"
                    android:gravity="center"
                    android:text="i"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/satoshi_medium"
                    android:text="Tap any count to see employee detail"
                    android:textColor="#1E3A8A"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>


    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:gravity="center"
        android:visibility="gone"
        android:layout_height="match_parent">

        <ImageView
            android:layout_width="wrap_content"
            android:src="@drawable/bg_emty"
            android:layout_height="wrap_content"></ImageView>
    </LinearLayout>
</LinearLayout>