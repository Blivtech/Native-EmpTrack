<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F9">

    <!-- ✅ Topbar (color set dynamically) -->
    <LinearLayout
        android:id="@+id/layoutTopbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1B5E20">

        <!-- Title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="13dp"
            android:paddingBottom="10dp">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:src="@drawable/ic_nav_home"
                android:tint="#FFFFFF"
                android:background="@drawable/bg_circle_white18"
                android:layout_marginEnd="8dp"
                android:padding="5dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvShiftTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_caption_th"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:id="@+id/tvShiftSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_caption_small"
                    android:textColor="#99FFFFFF"
                    android:layout_marginTop="1dp"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/btnDownload"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:src="@android:drawable/ic_menu_save"
                android:tint="#FFFFFF"
                android:background="@drawable/bg_circle_white15"
                android:padding="5dp"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- Type + count bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:paddingBottom="11dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_circle_white15"
                android:padding="6dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/tvTypeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_caption_md"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="6dp"/>

                <TextView
                    android:id="@+id/tvTypeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_caption_md"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_circle_white18"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvShiftTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="9sp"
                android:textColor="#88FFFFFF"
                android:background="@drawable/bg_circle_white15"
                android:padding="6dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginStart="7dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Search bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:padding="8dp"
        android:paddingStart="11dp"
        android:paddingEnd="11dp"
        android:elevation="3dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@android:drawable/ic_menu_search"
            android:tint="#BDBDBD"
            android:layout_marginEnd="7dp"/>

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Search employee name or code..."
            android:textSize="@dimen/text_caption_md"
            android:textColor="#212121"
            android:textColorHint="#BDBDBD"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true"/>

        <ImageView
            android:id="@+id/ivClearSearch"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#BDBDBD"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- List label -->
    <TextView
        android:id="@+id/tvListLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="7sp"
        android:textStyle="bold"
        android:textColor="#BDBDBD"
        android:letterSpacing="0.07"
        android:layout_marginStart="11dp"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="5dp"/>

    <!-- Employee list -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:paddingBottom="12dp">

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="40dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No results found"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#BDBDBD"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Try a different name or code"
                    android:textSize="11sp"
                    android:textColor="#E0E0E0"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>

            <!-- Employee rows (dynamic) -->
            <LinearLayout
                android:id="@+id/layoutEmployees"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"/>

        </LinearLayout>
    </ScrollView>

    <!-- Download bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:padding="9dp"
        android:elevation="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_badge_red_light"
            android:orientation="horizontal"
            android:layout_marginEnd="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PDF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#C62828"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_badge_green_light"
            android:orientation="horizontal"
            android:layout_marginEnd="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Excel"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#1B5E20"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_badge_blue"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Share"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#0C447C"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>