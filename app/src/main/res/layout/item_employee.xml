<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="15dp">

        <!-- Avatar (rounded square) -->
        <TextView
            android:id="@+id/tvInitials"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1D4ED8"
            android:background="@drawable/bg_ava_blue"
            android:layout_marginEnd="13dp" />

        <!-- Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEmpName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/satoshi_medium"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:id="@+id/tvEmpRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/satoshi_medium"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvEmpDept"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/satoshi_medium"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#2563EB"
                android:drawableStart="@drawable/ic_phone"
                android:drawableTint="#2563EB"
                android:drawablePadding="5dp"
                android:layout_marginTop="7dp" />
        </LinearLayout>

        <!-- Right side -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/satoshi_medium"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#16A34A"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_marginBottom="10dp" />

            <ImageView
                android:id="@+id/ivCall"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_phone"
                android:tint="#16A34A"
                android:background="@drawable/bg_call_green"
                android:padding="11dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>