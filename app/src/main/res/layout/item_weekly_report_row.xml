<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:background="@drawable/bg_row_divider">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/tvEmpName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/satoshi_medium" android:textSize="15.5sp" android:textStyle="bold" android:textColor="#0F172A"/>
        <TextView android:id="@+id/tvEmpCode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/satoshi_medium" android:textSize="12.5sp" android:textColor="#94A3B8" android:layout_marginTop="1dp"/>
    </LinearLayout>
    <TextView android:id="@+id/tvPresent" style="@style/WkPill" android:background="@drawable/bg_pill_p" android:textColor="#16A34A"/>
    <TextView android:id="@+id/tvAbsent" style="@style/WkPill" android:background="@drawable/bg_pill_l" android:textColor="#DC2626"/>
    <TextView android:id="@+id/tvHoliday" style="@style/WkPill" android:background="@drawable/bg_pill_h" android:textColor="#FFFFFF"/>
    <TextView android:id="@+id/tvWeekOff" style="@style/WkPill" android:background="@drawable/bg_pill_wo" android:textColor="#94A3B8"/>
    <TextView android:id="@+id/tvTotal" android:layout_width="44dp" android:layout_height="wrap_content" android:gravity="center" android:fontFamily="@font/satoshi_medium" android:textSize="16sp" android:textStyle="bold" android:textColor="#2563EB"/>
</LinearLayout>