<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/et_surface">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="10dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Product"
                    android:textColor="@color/et_ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Choose work, then count"
                    android:textColor="@color/et_muted"
                    android:textSize="12sp" />
            </LinearLayout>
            <ImageButton
                android:id="@+id/close"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/et_paper"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="Close"
                app:tint="@color/et_muted" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/workChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true" />

        <!-- Counter -->
        <LinearLayout
            android:id="@+id/counterGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageButton
                    android:id="@+id/minus"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/et_primary_wash"
                    android:src="@android:drawable/ic_media_previous"
                    android:contentDescription="Minus"
                    app:tint="@color/et_primary" />
                <TextView
                    android:id="@+id/count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/et_ink"
                    android:textSize="40sp"
                    android:textStyle="bold" />
                <ImageButton
                    android:id="@+id/plus"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/et_primary"
                    android:src="@android:drawable/ic_media_next"
                    android:contentDescription="Plus"
                    app:tint="@android:color/white" />
            </LinearLayout>

            <TextView
                android:id="@+id/amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="= ₹0"
                android:textColor="@color/et_money"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingTop="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingTop="10dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/add5"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="+5"
                    android:textAllCaps="false"
                    app:cornerRadius="12dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/add10"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="+10"
                    android:textAllCaps="false"
                    app:cornerRadius="12dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/add25"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+25"
                    android:textAllCaps="false"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/delete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Delete entry"
            android:textAllCaps="false"
            android:textColor="@color/et_danger"
            app:cornerRadius="14dp"
            app:backgroundTint="@color/et_danger_wash"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cancel"
                android:textAllCaps="false"
                app:cornerRadius="14dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:layout_marginStart="11dp"
                android:text="Save entry"
                android:textAllCaps="false"
                app:cornerRadius="14dp"
                android:backgroundTint="@color/et_primary" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>