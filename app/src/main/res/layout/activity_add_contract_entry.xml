<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <!-- Topbar with date + shift -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/primary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/padding_lg"
            android:paddingBottom="@dimen/padding_sm">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="@dimen/margin_md"
                android:src="@drawable/ic_nav_home"
                android:tint="@color/white"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Add Work Entry"
                android:textColor="@color/white"
                android:textSize="@dimen/text_caption_th"
                android:fontFamily="@font/satoshi_bold"/>

        </LinearLayout>

        <!-- Date + Shift -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/primary_dark">

            <!-- DATE -->

            <LinearLayout
                android:id="@+id/layoutDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/padding_md">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="@dimen/margin_sm"
                    android:src="@android:drawable/ic_menu_my_calendar"
                    android:tint="@color/white"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DATE"
                        android:textColor="#88FFFFFF"
                        android:textSize="@dimen/text_caption_vs"
                        android:fontFamily="@font/satoshi_medium"/>

                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_caption_small"
                        android:fontFamily="@font/satoshi_bold"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvDateSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today"
                    android:textColor="#88FFFFFF"
                    android:textSize="@dimen/text_caption_vs"
                    android:fontFamily="@font/satoshi_regular"/>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="@dimen/margin_sm"
                    android:src="@android:drawable/arrow_down_float"
                    android:tint="@color/white"/>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="#22FFFFFF"/>

            <!-- SHIFT -->

            <LinearLayout
                android:id="@+id/layoutShift"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/padding_md"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="@dimen/margin_sm"
                    android:src="@android:drawable/ic_menu_day"
                    android:tint="@color/white"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SHIFT"
                        android:textColor="#88FFFFFF"
                        android:textSize="@dimen/text_caption_vs"
                        android:fontFamily="@font/satoshi_medium"/>

                    <TextView
                        android:id="@+id/tvShiftName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Detecting..."
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_caption_small"
                        android:fontFamily="@font/satoshi_bold"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvShiftTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#88FFFFFF"
                    android:textSize="@dimen/text_caption_vs"
                    android:fontFamily="@font/satoshi_regular"/>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="@dimen/margin_sm"
                    android:src="@android:drawable/arrow_down_float"
                    android:tint="@color/white"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Scrollable Content -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_md">

            <!-- Section Title -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_sm"
                android:text="SELECT PRODUCT → ENTER QUANTITY"
                android:textColor="@color/hint_color"
                android:textSize="@dimen/text_caption_vs"
                android:fontFamily="@font/satoshi_bold"
                android:letterSpacing="0.08"/>

            <!-- Dynamic Product Rows -->

            <LinearLayout
                android:id="@+id/layoutRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>



            <!-- Add Product Button -->

            <LinearLayout
                android:id="@+id/btnAddRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_sm"
                android:background="@drawable/bg_add_row_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/padding_md">

                <ImageView
                    android:layout_width="@dimen/icon_sm"
                    android:layout_height="@dimen/icon_sm"
                    android:layout_marginEnd="@dimen/margin_sm"
                    android:src="@android:drawable/ic_input_add"
                    android:tint="@color/primary"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Add another product"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_caption_small"
                    android:fontFamily="@font/satoshi_bold"/>

            </LinearLayout>

            <!-- Total Card -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_md"
                android:background="@drawable/bg_badge_blue"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/padding_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTotalEntries"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 entries"
                        android:textColor="@color/blue_dark"
                        android:textSize="@dimen/text_caption_small"
                        android:fontFamily="@font/satoshi_bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Total amount"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption_vs"
                        android:fontFamily="@font/satoshi_regular"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹0"
                    android:textColor="@color/blue_dark"
                    android:textSize="22sp"
                    android:fontFamily="@font/satoshi_black"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Save Bar -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="@dimen/elevation_md"
        android:orientation="vertical"
        android:padding="@dimen/padding_md">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:enabled="false"
            android:fontFamily="@font/satoshi_bold"
            android:text="Save Entry"
            android:textAllCaps="false"
            android:textSize="@dimen/text_caption_md"
            app:backgroundTint="#BDBDBD"
            app:cornerRadius="@dimen/radius_lg"/>

    </LinearLayout>

</LinearLayout>






