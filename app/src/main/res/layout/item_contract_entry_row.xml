<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_field_selector"
    android:padding="10dp"
    android:layout_marginBottom="8dp">

    <!-- Row header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <!-- ✅ Row number badge -->
        <TextView
            android:id="@+id/tvRowNum"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:gravity="center"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_circle_blue"
            android:layout_marginEnd="7dp"/>

        <!-- ✅ Product picker -->
        <LinearLayout
            android:id="@+id/layoutProductPicker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_field_selector"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRODUCT"
                android:textSize="7sp"
                android:textStyle="bold"
                android:textColor="#9E9E9E"
                android:letterSpacing="0.06"/>

            <!-- ✅ tvProductLabel -->
            <TextView
                android:id="@+id/tvProductLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to select"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#BDBDBD"
                android:layout_marginTop="2dp"/>

            <!-- ✅ tvProductSub -->
            <TextView
                android:id="@+id/tvProductSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="9sp"
                android:textColor="#1565C0"
                android:layout_marginTop="1dp"/>
        </LinearLayout>

        <!-- ✅ Delete -->
        <ImageView
            android:id="@+id/btnDelete"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="#E24B4A"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- Qty + Amount -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- ✅ layoutQty -->
        <LinearLayout
            android:id="@+id/layoutQty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_pieces_input"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUANTITY"
                android:textSize="7sp"
                android:textStyle="bold"
                android:textColor="#9E9E9E"
                android:letterSpacing="0.06"/>

            <!-- ✅ gravity bottom — fixes baseline error -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <!-- ✅ tvQtyVal -->
                <TextView
                    android:id="@+id/tvQtyVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"/>

                <!-- ✅ tvQtyUnit -->
                <TextView
                    android:id="@+id/tvQtyUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="10sp"
                    android:textColor="#9E9E9E"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="2dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Arrow -->
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@android:drawable/ic_media_next"
            android:tint="#BDBDBD"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"/>

        <!-- Amount box -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_amount_box"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AMOUNT"
                android:textSize="7sp"
                android:textStyle="bold"
                android:textColor="#639922"
                android:letterSpacing="0.06"/>

            <!-- ✅ tvAmount -->
            <TextView
                android:id="@+id/tvAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#27500A"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>