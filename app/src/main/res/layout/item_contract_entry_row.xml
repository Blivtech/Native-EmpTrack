<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_field_selector"
    android:padding="@dimen/padding_md"
    android:layout_marginBottom="@dimen/margin_sm">

    <!-- Row Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_sm"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Row Number -->
        <TextView
            android:id="@+id/tvRowNum"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="@dimen/margin_sm"
            android:background="@drawable/bg_circle_blue"
            android:fontFamily="@font/satoshi_bold"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="@dimen/text_caption_vs"/>

        <!-- Product Picker -->
        <LinearLayout
            android:id="@+id/layoutProductPicker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_field_selector"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="@dimen/padding_sm">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRODUCT"
                android:textColor="@color/text_secondary"
                android:textSize="8sp"
                android:fontFamily="@font/satoshi_bold"
                android:letterSpacing="0.06"/>

            <TextView
                android:id="@+id/tvProductLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/satoshi_bold"
                android:text="Tap to select"
                android:textColor="@color/hint_color"
                android:textSize="@dimen/text_caption_small"/>

            <TextView
                android:id="@+id/tvProductSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/satoshi_regular"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_caption_vs"/>

        </LinearLayout>

        <!-- Delete -->
        <ImageView
            android:id="@+id/btnDelete"
            android:layout_width="@dimen/icon_sm"
            android:layout_height="@dimen/icon_sm"
            android:layout_marginStart="@dimen/margin_sm"
            android:clickable="true"
            android:focusable="true"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="@color/red_dark"/>

    </LinearLayout>

    <!-- Quantity + Amount -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Quantity -->
        <LinearLayout
            android:id="@+id/layoutQty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_pieces_input"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="@dimen/padding_sm">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUANTITY"
                android:textColor="@color/text_secondary"
                android:textSize="8sp"
                android:fontFamily="@font/satoshi_bold"
                android:letterSpacing="0.06"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvQtyVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/satoshi_bold"
                    android:text="0"
                    android:textColor="@color/primary"
                    android:textSize="20sp"/>

                <TextView
                    android:id="@+id/tvQtyUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="2dp"
                    android:fontFamily="@font/satoshi_regular"
                    android:text="—"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption_vs"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Arrow -->
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:src="@android:drawable/ic_media_next"
            android:tint="@color/hint_color"/>

        <!-- Amount -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_amount_box"
            android:orientation="vertical"
            android:padding="@dimen/padding_sm">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AMOUNT"
                android:textColor="@color/green_stroke"
                android:textSize="8sp"
                android:fontFamily="@font/satoshi_bold"
                android:letterSpacing="0.06"/>

            <TextView
                android:id="@+id/tvAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/satoshi_bold"
                android:text="₹0"
                android:textColor="@color/green_dark"
                android:textSize="20sp"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>