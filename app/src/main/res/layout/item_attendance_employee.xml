<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_card_unselected" android:padding="14dp" android:layout_marginBottom="11dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
        <TextView android:id="@+id/tvInitials" android:layout_width="46dp" android:layout_height="46dp" android:gravity="center"
            android:textSize="17sp" android:fontFamily="@font/satoshi_medium" android:textStyle="bold" android:textColor="#0C447C"
            android:background="@drawable/bg_avatar" android:layout_marginEnd="12dp"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/tvEmpName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="@font/satoshi_medium" android:textSize="16sp" android:textStyle="bold" android:textColor="#0F172A"/>
            <TextView android:id="@+id/tvEmpCode" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="@font/satoshi_medium" android:textSize="12.5sp" android:textColor="#94A3B8" android:layout_marginTop="1dp"/>
        </LinearLayout>
        <TextView android:id="@+id/tvStatusBadge" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="@font/satoshi_medium" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFF"
            android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:visibility="gone"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="0dp">
        <TextView android:id="@+id/btnWorking" style="@style/AttStatusBtn" android:text="Working" android:layout_marginEnd="7dp"/>
        <TextView android:id="@+id/btnWeekoff" style="@style/AttStatusBtn" android:text="Week off" android:layout_marginEnd="7dp"/>
        <TextView android:id="@+id/btnLeave"   style="@style/AttStatusBtn" android:text="Leave" android:layout_marginEnd="7dp"/>
        <TextView android:id="@+id/btnHoliday" style="@style/AttStatusBtn" android:text="Holiday"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/layoutSubOptions" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="7dp" android:visibility="gone">
        <TextView android:id="@+id/btnFullDay" style="@style/AttSubBtn" android:text="Full day" android:layout_marginEnd="7dp"/>
        <TextView android:id="@+id/btnHalfDay" style="@style/AttSubBtn" android:text="Half day"/>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="2"/>
    </LinearLayout>
</LinearLayout>
