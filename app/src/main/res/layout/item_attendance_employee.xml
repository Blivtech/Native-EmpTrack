<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_unselected"
    android:padding="10dp"
    android:layout_marginBottom="8dp">

    <!-- Employee info row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvInitials"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#0C447C"
            android:background="@drawable/bg_circle_blue"
            android:layout_marginEnd="10dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEmpName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#212121"/>

            <TextView
                android:id="@+id/tvEmpCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#757575"
                android:layout_marginTop="1dp"/>
        </LinearLayout>

        <!-- ✅ Status badge -->
        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="9sp"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- ✅ Status buttons — Working / Week off / Leave / Holiday -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/btnWorking"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Working"
            android:textSize="10sp"
            android:textColor="#212121"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_field_trigger"/>

        <TextView
            android:id="@+id/btnWeekoff"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Week off"
            android:textSize="10sp"
            android:textColor="#212121"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_field_trigger"/>

        <TextView
            android:id="@+id/btnLeave"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Leave"
            android:textSize="10sp"
            android:textColor="#212121"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_field_trigger"/>

        <TextView
            android:id="@+id/btnHoliday"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Holiday"
            android:textSize="10sp"
            android:textColor="#212121"
            android:background="@drawable/bg_field_trigger"/>
    </LinearLayout>

    <!-- ✅ Full day / Half day sub-options — shown only when Working selected -->
    <LinearLayout
        android:id="@+id/layoutSubOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnFullDay"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Full day"
            android:textSize="10sp"
            android:textColor="#212121"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_field_trigger"/>

        <TextView
            android:id="@+id/btnHalfDay"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Half day"
            android:textSize="10sp"
            android:textColor="#212121"
            android:background="@drawable/bg_field_trigger"/>

        <!-- ✅ Empty spacer to keep buttons left-aligned -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="2"/>

    </LinearLayout>
</LinearLayout>