<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#EEF2F8">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:background="@drawable/bg_header_teal" android:paddingTop="42dp" android:paddingBottom="42dp" android:paddingStart="16dp" android:paddingEnd="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/ivBack" android:layout_width="38dp" android:layout_height="38dp"
                android:src="@drawable/ic_arrow_back" android:tint="#FFFFFF" android:padding="9dp" android:background="@drawable/bg_icon_btn" android:layout_marginEnd="12dp" android:clickable="true" android:focusable="true"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bonus Report"
                    android:fontFamily="@font/satoshi_medium" android:textSize="21sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
                <TextView android:id="@+id/tvCompanyName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="@font/satoshi_medium" android:textSize="12.5sp" android:textColor="#B6E3D6" android:layout_marginTop="1dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="14dp">
            <ImageView android:id="@+id/btnPrevMonth" android:layout_width="36dp" android:layout_height="36dp"
                android:src="@drawable/ic_skip_prev" android:tint="#FFFFFF" android:padding="10dp" android:background="@drawable/bg_navbtn" android:clickable="true" android:focusable="true"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/tvMonthLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="@font/satoshi_medium" android:textSize="17sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
                <TextView android:id="@+id/tvSummary" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="@font/satoshi_medium" android:textSize="12sp" android:textStyle="bold" android:textColor="#B6E3D6" android:layout_marginTop="2dp"/>
            </LinearLayout>
            <ImageView android:id="@+id/btnNextMonth" android:layout_width="36dp" android:layout_height="36dp"
                android:src="@drawable/ic_skip_next" android:tint="#FFFFFF" android:padding="10dp" android:background="@drawable/bg_navbtn" android:clickable="true" android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>

    <ProgressBar android:id="@+id/progressBar" android:layout_width="match_parent" android:layout_height="3dp"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal" android:indeterminate="true" android:indeterminateTint="#0B7A63" android:visibility="gone"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="16dp">
            <LinearLayout android:id="@+id/layoutEntries" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="14dp"/>
            <LinearLayout android:id="@+id/layoutEmpty" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center" android:padding="40dp" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No bonus entries this month"
                    android:textSize="14sp" android:textStyle="bold" android:fontFamily="@font/satoshi_medium" android:textColor="#94A3B8"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
