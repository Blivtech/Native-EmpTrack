<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog">

    <!-- Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_sheet_handle"/>

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvConfirmTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/satoshi_medium"
            android:text="Confirm attendance"
            android:textColor="@color/black_overlay_80"
            android:textSize="@dimen/text_caption_md"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Review before submitting"
            android:fontFamily="@font/satoshi_medium"
            android:textSize="@dimen/text_caption_small"
            android:textColor="#757575"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#E0E0E0"/>

    <!-- Shift info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_salary_summary"
        android:padding="10dp"
        android:layout_margin="12dp">

        <LinearLayout
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:background="@drawable/bg_circle_blue"
            android:layout_marginEnd="10dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/ic_menu_day"
                android:tint="#0C447C"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvConfirmShift"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/satoshi_medium"
                android:textSize="@dimen/text_caption_md"
                android:textStyle="bold"
                android:textColor="@color/black_overlay_80"/>

            <TextView
                android:id="@+id/tvConfirmTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/satoshi_medium"
                android:textSize="@dimen/text_caption_small"
                android:textColor="#757575"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvConfirmTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#1565C0"/>
    </LinearLayout>

    <!-- Summary grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp">

        <!-- Working -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_card_working"
            android:padding="10dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp">
            <TextView
                android:id="@+id/tvConfirmWorking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:fontFamily="@font/satoshi_medium"
                android:textSize="@dimen/text_caption_lg"
                android:textStyle="bold"
                android:textColor="#27500A"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Working"
                android:fontFamily="@font/satoshi_medium"
                android:textSize="@dimen/text_caption_md"
                android:textColor="#3B6D11"
                android:layout_marginTop="1dp"/>
            <TextView
                android:id="@+id/tvWorkingDetail"
                android:layout_width="wrap_content"
                android:visibility="gone"
                android:layout_height="wrap_content"
                android:textSize="9sp"
                android:textColor="#639922"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Week off -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_card_weekoff"
            android:padding="10dp"
            android:layout_marginBottom="5dp">
            <TextView
                android:id="@+id/tvConfirmWeekoff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:fontFamily="@font/satoshi_medium"
                android:textSize="@dimen/text_caption_lg"
                android:textStyle="bold"
                android:textColor="#633806"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Week off"
                android:fontFamily="@font/satoshi_medium"
                android:textSize="@dimen/text_caption_lg"
                android:textColor="#854F0B"
                android:layout_marginTop="1dp"/>
        </LinearLayout>

        <!-- Leave -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_card_leave"
            android:padding="10dp"
            android:layout_marginEnd="5dp">
            <TextView
                android:id="@+id/tvConfirmLeave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:fontFamily="@font/satoshi_medium"
                android:textSize="@dimen/text_caption_lg"
                android:textStyle="bold"
                android:textColor="#0C447C"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Leave"
                android:fontFamily="@font/satoshi_medium"
                android:textSize="@dimen/text_caption_md"
                android:textColor="#185FA5"
                android:layout_marginTop="1dp"/>
        </LinearLayout>

        <!-- Holiday -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_card_holiday"
            android:padding="10dp">
            <TextView
                android:id="@+id/tvConfirmHoliday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:fontFamily="@font/satoshi_medium"
                android:textSize="@dimen/text_caption_lg"
                android:textStyle="bold"
                android:textColor="#3C3489"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Holiday"
                android:fontFamily="@font/satoshi_medium"
                android:textSize="@dimen/text_caption_md"
                android:textColor="#534AB7"
                android:layout_marginTop="1dp"/>
        </LinearLayout>

    </GridLayout>

    <!-- Employee list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvConfirmList"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"
        android:nestedScrollingEnabled="true"/>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/btnEdit"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="← Edit"
            android:fontFamily="@font/satoshi_medium"
            android:textSize="@dimen/text_caption_md"
            android:textColor="#757575"
            android:background="@drawable/bg_field_trigger"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/btnConfirm"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="2"
            android:gravity="center"
            android:text="Confirm &amp; Submit ✓"
            android:fontFamily="@font/satoshi_medium"
            android:textSize="@dimen/text_caption_md"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_dialog_btn"/>

    </LinearLayout>
</LinearLayout>