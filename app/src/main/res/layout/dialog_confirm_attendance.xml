<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_dialog">

    <View android:layout_width="44dp" android:layout_height="5dp" android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp" android:background="@drawable/bg_sheet_handle"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:paddingBottom="12dp">
        <TextView android:id="@+id/tvConfirmTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Confirm attendance"
            android:fontFamily="@font/satoshi_medium" android:textSize="20sp" android:textStyle="bold" android:textColor="#0F172A"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Review before submitting"
            android:fontFamily="@font/satoshi_medium" android:textSize="13sp" android:textColor="#94A3B8" android:layout_marginTop="2dp"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:background="@drawable/bg_salary_summary" android:padding="13dp" android:layout_margin="16dp" android:layout_marginBottom="8dp">
        <LinearLayout android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:background="@drawable/bg_circle_blue" android:layout_marginEnd="11dp">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@android:drawable/ic_menu_day" android:tint="#FFFFFF"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/tvConfirmShift" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="@font/satoshi_medium" android:textSize="14.5sp" android:textStyle="bold" android:textColor="#0F172A"/>
            <TextView android:id="@+id/tvConfirmTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="@font/satoshi_medium" android:textSize="12sp" android:textColor="#94A3B8" android:layout_marginTop="2dp"/>
        </LinearLayout>
        <TextView android:id="@+id/tvConfirmTotal" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="@font/satoshi_medium" android:textSize="13sp" android:textStyle="bold" android:textColor="#1D4ED8"/>
    </LinearLayout>

    <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="8dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical"
            android:background="@drawable/bg_card_working" android:padding="14dp" android:layout_marginEnd="5dp" android:layout_marginBottom="10dp">
            <TextView android:id="@+id/tvConfirmWorking" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0"
                android:fontFamily="@font/satoshi_medium" android:textSize="22sp" android:textStyle="bold" android:textColor="#15803D"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Working"
                android:fontFamily="@font/satoshi_medium" android:textSize="13sp" android:textStyle="bold" android:textColor="#16A34A" android:layout_marginTop="1dp"/>
            <TextView android:id="@+id/tvWorkingDetail" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10.5sp" android:textColor="#16A34A" android:layout_marginTop="2dp" android:visibility="gone"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical"
            android:background="@drawable/bg_card_weekoff" android:padding="14dp" android:layout_marginBottom="10dp">
            <TextView android:id="@+id/tvConfirmWeekoff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0"
                android:fontFamily="@font/satoshi_medium" android:textSize="22sp" android:textStyle="bold" android:textColor="#B45309"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Week off"
                android:fontFamily="@font/satoshi_medium" android:textSize="13sp" android:textStyle="bold" android:textColor="#D97706" android:layout_marginTop="1dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical"
            android:background="@drawable/bg_card_leave" android:padding="14dp" android:layout_marginEnd="5dp">
            <TextView android:id="@+id/tvConfirmLeave" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0"
                android:fontFamily="@font/satoshi_medium" android:textSize="22sp" android:textStyle="bold" android:textColor="#1D4ED8"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Leave"
                android:fontFamily="@font/satoshi_medium" android:textSize="13sp" android:textStyle="bold" android:textColor="#2563EB" android:layout_marginTop="1dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical"
            android:background="@drawable/bg_card_holiday" android:padding="14dp">
            <TextView android:id="@+id/tvConfirmHoliday" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0"
                android:fontFamily="@font/satoshi_medium" android:textSize="22sp" android:textStyle="bold" android:textColor="#6D28D9"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Holiday"
                android:fontFamily="@font/satoshi_medium" android:textSize="13sp" android:textStyle="bold" android:textColor="#7C3AED" android:layout_marginTop="1dp"/>
        </LinearLayout>
    </GridLayout>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvConfirmList"
        android:layout_width="match_parent" android:layout_height="200dp"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="8dp" android:nestedScrollingEnabled="true" android:scrollbars="none"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:paddingBottom="20dp">
        <TextView android:id="@+id/btnEdit" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:gravity="center"
            android:text="← Edit" android:fontFamily="@font/satoshi_medium" android:textSize="14.5sp" android:textStyle="bold" android:textColor="#475569"
            android:background="@drawable/bg_field_trigger" android:layout_marginEnd="10dp" android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/btnConfirm" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1.6" android:gravity="center"
            android:text="Confirm &amp; Submit ✓" android:fontFamily="@font/satoshi_medium" android:textSize="14.5sp" android:textStyle="bold" android:textColor="#FFFFFF"
            android:background="@drawable/bg_dialog_btn" android:clickable="true" android:focusable="true"/>
    </LinearLayout>
</LinearLayout>
