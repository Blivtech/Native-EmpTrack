<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_report_card"
    android:layout_marginBottom="12dp">
    <!--  header  -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvShiftEmoji"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:textSize="22sp"
            android:background="@drawable/bg_shift_badge"
            android:layout_marginEnd="13dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvShiftName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/satoshi_medium"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:id="@+id/tvShiftTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/satoshi_medium"
                android:textSize="13.5sp"
                android:textColor="#94A3B8"
                android:layout_marginTop="1dp" />
        </LinearLayout>
        <!--  badge bg + colour set in code (bg_badge_green / bg_badge_amber)  -->
        <TextView
            android:id="@+id/tvSubmitBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="@font/satoshi_medium"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp" />
    </LinearLayout>
    <!--  meta strip  -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_meta"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="5dp">

            <TextView
                android:layout_width="118dp"
                android:layout_height="wrap_content"
                android:text="Date"
                android:textSize="13.5sp"
                android:fontFamily="@font/satoshi_medium"
                android:textColor="#94A3B8" />

            <TextView
                android:id="@+id/tvMetaDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:fontFamily="@font/satoshi_medium"
                android:textStyle="bold"
                android:textColor="#0F172A" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="118dp"
                android:layout_height="wrap_content"
                android:text="Submitted Date"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:fontFamily="@font/satoshi_medium"
                android:textColor="#94A3B8" />

            <TextView
                android:id="@+id/tvMetaSubmit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/satoshi_medium" />
        </LinearLayout>
    </LinearLayout>
    <!--  tiles  -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:id="@+id/pillPresent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_tile_present"
            android:paddingTop="14dp"
            android:paddingBottom="12dp"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvPresentCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:fontFamily="@font/satoshi_medium"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#16A34A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Present"
                android:textSize="13sp"
                android:fontFamily="@font/satoshi_medium"
                android:textStyle="bold"
                android:textColor="#16A34A"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to view"
                android:textSize="9sp"
                android:textColor="#94A3B8"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pillLeave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_tile_leave"
            android:paddingTop="14dp"
            android:paddingBottom="12dp"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvLeaveCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:fontFamily="@font/satoshi_medium"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#DC2626" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Leave"
                android:textSize="13sp"
                android:fontFamily="@font/satoshi_medium"
                android:textStyle="bold"
                android:textColor="#DC2626"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to view"
                android:textSize="9sp"
                android:textColor="#94A3B8"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pillHoliday"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_tile_hwo"
            android:paddingTop="14dp"
            android:paddingBottom="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tvHolidayCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:fontFamily="@font/satoshi_medium"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#7C3AED" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="H / WO"
                android:textSize="13sp"
                android:fontFamily="@font/satoshi_medium"
                android:textStyle="bold"
                android:textColor="#7C3AED"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Holiday + WO"
                android:textSize="9sp"
                android:textColor="#A78BFA"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_tile_total"
            android:paddingTop="14dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvTotalCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:fontFamily="@font/satoshi_medium"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#2563EB" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total"
                android:textSize="13sp"
                android:fontFamily="@font/satoshi_medium"
                android:textStyle="bold"
                android:textColor="#2563EB"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All employees"
                android:textSize="9sp"
                android:textColor="#94A3B8"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>