<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF2F8"
    android:orientation="vertical">
    <!--  Header (blue, set in XML — no per-type recolor)  -->
    <LinearLayout
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="42dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_icon_btn"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/satoshi_medium"
                android:text="Add Entry"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCompanyName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/satoshi_medium"
                android:textColor="#CFE0FF"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <!--  TYPE  -->
            <TextView
                style="@style/EntryLabel"
                android:text="Select Type" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardOvertime"
                    style="@style/EntryTypeCard"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_card_working">

                    <ImageView
                        style="@style/EntryTypeIcon"
                        android:src="@drawable/ic_clock" />

                    <TextView
                        style="@style/EntryTypeLabel"
                        android:text="Overtime" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardAdvance"
                    style="@style/EntryTypeCard"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_card_unselected">

                    <ImageView
                        style="@style/EntryTypeIcon"
                        android:src="@drawable/ic_tool" />

                    <TextView
                        style="@style/EntryTypeLabel"
                        android:text="Advance" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardBonus"
                    style="@style/EntryTypeCard"
                    android:background="@drawable/bg_card_unselected">

                    <ImageView
                        style="@style/EntryTypeIcon"
                        android:src="@drawable/ic_gift" />

                    <TextView
                        style="@style/EntryTypeLabel"
                        android:text="Bonus" />
                </LinearLayout>
            </LinearLayout>
            <!--  MODE  -->
            <TextView
                style="@style/EntryLabel"
                android:text="Select Mode" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardSingle"
                    style="@style/EntryModeCard"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_badge_blue_light">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginBottom="4dp"
                        android:src="@drawable/ic_single"
                        android:tint="#2563EB" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/satoshi_medium"
                        android:text="Single"
                        android:textColor="#1E3A8A"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/satoshi_medium"
                        android:text="Own amount each"
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardMultiple"
                    style="@style/EntryModeCard"
                    android:background="@drawable/bg_card_unselected">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginBottom="4dp"
                        android:src="@drawable/ic_share"
                        android:tint="#94A3B8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/satoshi_medium"
                        android:text="Multiple"
                        android:textColor="#64748B"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/satoshi_medium"
                        android:text="Same amount all"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
            <!--  DATE  -->
            <TextView
                style="@style/EntryLabel"
                android:text="Date" />

            <LinearLayout
                android:id="@+id/layoutDate"
                style="@style/EntryField"
                android:layout_marginBottom="14dp">

                <ImageView
                    style="@style/EntryFieldIcon"
                    android:src="@drawable/ic_calendar" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/satoshi_medium"
                        android:textColor="#0F172A"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Tap to change"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView style="@style/EntryChevron" />
            </LinearLayout>
            <!--  SHIFT (OT only)  -->
            <LinearLayout
                android:id="@+id/layoutShiftField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    style="@style/EntryLabel"
                    android:text="Shift" />

                <LinearLayout
                    android:id="@+id/layoutShift"
                    style="@style/EntryField"
                    android:layout_marginBottom="14dp">

                    <ImageView
                        style="@style/EntryFieldIcon"
                        android:src="@drawable/ic_clock" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvShift"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/satoshi_medium"
                            android:hint="Select shift"
                            android:textColor="#0F172A"
                            android:textColorHint="#94A3B8"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvShiftTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <ImageView style="@style/EntryChevron" />
                </LinearLayout>
            </LinearLayout>
            <!--  SINGLE EMPLOYEE  -->
            <LinearLayout
                android:id="@+id/layoutSingleEmployee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/EntryLabel"
                    android:text="Employee" />

                <LinearLayout
                    android:id="@+id/layoutEmployee"
                    style="@style/EntryField"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/tvEmpInitials"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="11dp"
                        android:background="@drawable/bg_circle_blue"
                        android:fontFamily="@font/satoshi_medium"
                        android:gravity="center"
                        android:textColor="#1D4ED8"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvEmpName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/satoshi_medium"
                            android:hint="Select employee"
                            android:textColor="#0F172A"
                            android:textColorHint="#94A3B8"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvEmpCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_blue_light"
                        android:fontFamily="@font/satoshi_medium"
                        android:paddingStart="12dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="7dp"
                        android:text="Change"
                        android:textColor="#2563EB"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
            <!--  MULTIPLE EMPLOYEES  -->
            <LinearLayout
                android:id="@+id/layoutMultiEmployee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/EntryLabel"
                    android:text="Employees" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupEmployees"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/btnAddMore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_badge_blue_light"
                    android:fontFamily="@font/satoshi_medium"
                    android:hint="+ Select employees"
                    android:paddingStart="14dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp"
                    android:textColor="#2563EB"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <!--  OT HOURS  -->
            <LinearLayout
                android:id="@+id/layoutOtHours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/EntryLabel"
                    android:text="OT Hours" />

                <LinearLayout
                    style="@style/EntryField"
                    android:layout_marginBottom="14dp">

                    <ImageView
                        style="@style/EntryFieldIcon"
                        android:src="@drawable/ic_clock" />

                    <EditText
                        android:id="@+id/etOtHours"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="@font/satoshi_medium"
                        android:hint="e.g. 2.5"
                        android:inputType="numberDecimal"
                        android:singleLine="true"
                        android:textColor="#0F172A"
                        android:textColorHint="#CBD5E1"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="hrs"
                        android:textColor="#94A3B8"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
            <!--  AMOUNT  -->
            <TextView
                android:id="@+id/tvAmountLabel"
                style="@style/EntryLabel"
                android:text="Amount" />

            <LinearLayout
                style="@style/EntryField"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:text="₹"
                    android:textColor="#94A3B8"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etAmount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/satoshi_medium"
                    android:hint="0.00"
                    android:inputType="numberDecimal"
                    android:singleLine="true"
                    android:textColor="#0F172A"
                    android:textColorHint="#CBD5E1"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <!--  REPAY MONTH (Advance only)  -->
            <LinearLayout
                android:id="@+id/layoutRepayMonthField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/EntryLabel"
                    android:text="Repay Month" />

                <LinearLayout
                    android:id="@+id/layoutRepayMonth"
                    style="@style/EntryField"
                    android:layout_marginBottom="14dp">

                    <ImageView
                        style="@style/EntryFieldIcon"
                        android:src="@drawable/ic_calendar" />

                    <TextView
                        android:id="@+id/tvRepayMonth"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/satoshi_medium"
                        android:textColor="#0F172A"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView style="@style/EntryChevron" />
                </LinearLayout>
            </LinearLayout>
            <!--  BONUS TYPE (Bonus only)  -->
            <LinearLayout
                android:id="@+id/layoutBonusType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/EntryLabel"
                    android:text="Bonus Type" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupBonus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <!--  REMARKS  -->
            <TextView
                style="@style/EntryLabel"
                android:text="Remarks (optional)" />

            <EditText
                android:id="@+id/etRemarks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_field_trigger"
                android:fontFamily="@font/satoshi_medium"
                android:gravity="top"
                android:hint="Add remarks…"
                android:inputType="textMultiLine"
                android:minHeight="72dp"
                android:padding="14dp"
                android:textColor="#0F172A"
                android:textColorHint="#CBD5E1"
                android:textSize="14.5sp" />
        </LinearLayout>
    </ScrollView>
    <!--  Save bar  -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="10dp"
        android:orientation="vertical"
        android:padding="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:enabled="false"
            android:fontFamily="@font/satoshi_medium"
            android:text="Save"
            android:textAllCaps="false"
            android:textSize="15.5sp"
            android:textStyle="bold"
            app:backgroundTint="#CBD5E1"
            app:cornerRadius="14dp" />
    </LinearLayout>
</LinearLayout>