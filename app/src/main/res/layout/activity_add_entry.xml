<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1565C0"
        android:padding="14dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_nav_home"
                android:tint="#FFFFFF"
                android:padding="4dp"
                android:layout_marginEnd="10dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add Entry"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>
                <TextView
                    android:id="@+id/tvCompanyName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="#CCffffff"
                    android:layout_marginTop="1dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable form -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- ✅ Type selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SELECT TYPE"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#BDBDBD"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:id="@+id/cardOvertime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_card_working"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_recent_history"
                        android:tint="#27500A"
                        android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Overtime"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#27500A"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardAdvance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_card_unselected"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_manage"
                        android:tint="#BDBDBD"
                        android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Advance"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#BDBDBD"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardBonus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="@drawable/bg_card_unselected"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_agenda"
                        android:tint="#BDBDBD"
                        android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bonus"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#BDBDBD"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ✅ Mode selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SELECT MODE"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#BDBDBD"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:id="@+id/cardSingle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_badge_blue"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        android:tint="#0C447C"
                        android:layout_marginBottom="3dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Single"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#0C447C"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Own amount each"
                        android:textSize="9sp"
                        android:textColor="#185FA5"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardMultiple"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="@drawable/bg_card_unselected"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_share"
                        android:tint="#BDBDBD"
                        android:layout_marginBottom="3dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Multiple"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#9E9E9E"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Same amount all"
                        android:textSize="9sp"
                        android:textColor="#BDBDBD"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ✅ Date -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#757575"
                android:layout_marginBottom="4dp"/>
            <LinearLayout
                android:id="@+id/layoutDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_field_trigger"
                android:padding="12dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@android:drawable/ic_menu_my_calendar"
                    android:tint="#1565C0"
                    android:layout_marginEnd="10dp"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#212121"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to change"
                        android:textSize="9sp"
                        android:textColor="#9E9E9E"
                        android:layout_marginTop="1dp"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/arrow_down_float"
                    android:tint="#BDBDBD"/>
            </LinearLayout>

            <!-- ✅ Shift (OT only) -->
            <LinearLayout
                android:id="@+id/layoutShiftField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shift"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#757575"
                    android:layout_marginBottom="4dp"/>
                <LinearLayout
                    android:id="@+id/layoutShift"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_field_trigger"
                    android:padding="12dp"
                    android:layout_marginBottom="10dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_menu_day"
                        android:tint="#1565C0"
                        android:layout_marginEnd="10dp"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvShift"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Select shift"
                            android:textSize="13sp"
                            android:textColor="#BDBDBD"/>
                        <TextView
                            android:id="@+id/tvShiftTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="9sp"
                            android:textColor="#9E9E9E"
                            android:visibility="gone"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/arrow_down_float"
                        android:tint="#BDBDBD"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ✅ Single employee -->
            <LinearLayout
                android:id="@+id/layoutSingleEmployee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Employee"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#757575"
                    android:layout_marginBottom="4dp"/>
                <LinearLayout
                    android:id="@+id/layoutEmployee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_field_trigger"
                    android:padding="11dp"
                    android:layout_marginBottom="10dp"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:id="@+id/tvEmpInitials"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#0C447C"
                        android:background="@drawable/bg_circle_blue"
                        android:layout_marginEnd="10dp"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvEmpName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Select employee"
                            android:textSize="12sp"
                            android:textColor="#BDBDBD"/>
                        <TextView
                            android:id="@+id/tvEmpCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="9sp"
                            android:textColor="#9E9E9E"
                            android:visibility="gone"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Change"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#0C447C"
                        android:background="@drawable/bg_badge_blue"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ✅ Multiple employees -->
            <LinearLayout
                android:id="@+id/layoutMultiEmployee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Employees"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#757575"
                    android:layout_marginBottom="4dp"/>
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupEmployees"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:id="@+id/btnAddMore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Select employees"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"
                    android:background="@drawable/bg_badge_blue"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginBottom="10dp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- ✅ OT Hours -->
            <LinearLayout
                android:id="@+id/layoutOtHours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OT Hours"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#757575"
                    android:layout_marginBottom="4dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_field_trigger"
                    android:padding="12dp"
                    android:layout_marginBottom="10dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_menu_recent_history"
                        android:tint="#1565C0"
                        android:layout_marginEnd="10dp"/>
                    <EditText
                        android:id="@+id/etOtHours"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="e.g. 2.5"
                        android:textSize="13sp"
                        android:textColor="#212121"
                        android:textColorHint="#BDBDBD"
                        android:background="@null"
                        android:inputType="numberDecimal"
                        android:singleLine="true"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="hrs"
                        android:textSize="12sp"
                        android:textColor="#9E9E9E"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ✅ Amount -->
            <TextView
                android:id="@+id/tvAmountLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Amount"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#757575"
                android:layout_marginBottom="4dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_field_trigger"
                android:padding="12dp"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#BDBDBD"
                    android:layout_marginEnd="8dp"/>
                <EditText
                    android:id="@+id/etAmount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="0.00"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:textColorHint="#BDBDBD"
                    android:background="@null"
                    android:inputType="numberDecimal"
                    android:singleLine="true"/>
            </LinearLayout>

            <!-- ✅ Repay month (Advance only) -->
            <LinearLayout
                android:id="@+id/layoutRepayMonthField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Repay Month"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#757575"
                    android:layout_marginBottom="4dp"/>
                <LinearLayout
                    android:id="@+id/layoutRepayMonth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_field_trigger"
                    android:padding="12dp"
                    android:layout_marginBottom="10dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_menu_my_calendar"
                        android:tint="#EF9F27"
                        android:layout_marginEnd="10dp"/>
                    <TextView
                        android:id="@+id/tvRepayMonth"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="13sp"
                        android:textColor="#212121"/>
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/arrow_down_float"
                        android:tint="#BDBDBD"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ✅ Bonus type (Bonus only) -->
            <LinearLayout
                android:id="@+id/layoutBonusType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bonus Type"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#757575"
                    android:layout_marginBottom="6dp"/>
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupBonus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- ✅ Remarks -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remarks (optional)"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#757575"
                android:layout_marginBottom="4dp"/>
            <EditText
                android:id="@+id/etRemarks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="70dp"
                android:hint="Add remarks..."
                android:textSize="12sp"
                android:textColor="#212121"
                android:textColorHint="#BDBDBD"
                android:background="@drawable/bg_field_trigger"
                android:padding="12dp"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:layout_marginBottom="10dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- ✅ Save button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:elevation="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Save"
            android:textSize="14sp"
            android:textStyle="bold"
            android:enabled="false"
            app:cornerRadius="12dp"
            app:backgroundTint="#BDBDBD"/>
    </LinearLayout>

</LinearLayout>