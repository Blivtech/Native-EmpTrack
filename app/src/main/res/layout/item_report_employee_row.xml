<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/bg_card"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="2dp"
    android:elevation="1dp">

    <!-- Avatar: single TextView handles background + centered initials,
         no FrameLayout or separate View needed -->
    <TextView
        android:id="@+id/tvAvatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_shift_morning"
        android:gravity="center"
        android:textSize="@dimen/text_caption_md"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:fontFamily="@font/satoshi_medium" />

    <!-- Employee info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvEmpName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_caption_md"
            android:fontFamily="@font/satoshi_medium"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvEmpCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_caption_small"
            android:fontFamily="@font/satoshi_medium"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvEmpDept"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_caption_md"
            android:fontFamily="@font/satoshi_medium"
            android:textColor="@color/accent_blue"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Status + late indicator -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/bg_status_chip"
            android:fontFamily="@font/satoshi_medium"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:textSize="@dimen/text_caption_small"
            android:textStyle="bold" />

        <!-- Shows "+32 min" for late employees -->
        <TextView
            android:id="@+id/tvLateMinutes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:fontFamily="@font/satoshi_medium"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="3dp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>