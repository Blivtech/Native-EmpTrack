<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
    android:orientation="vertical" android:gravity="center"
    android:background="@drawable/bg_date_hwo" android:paddingTop="11dp" android:paddingBottom="9dp"
    android:layout_marginStart="4dp" android:layout_marginEnd="4dp">
    <TextView android:id="@+id/tvDate" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:fontFamily="@font/satoshi_medium" android:textSize="13.5sp" android:textStyle="bold" android:textColor="#0F172A"/>
    <TextView android:id="@+id/tvWeekday" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:fontFamily="@font/satoshi_medium" android:textSize="10.5sp" android:textColor="#64748B" android:layout_marginTop="1dp"/>
</LinearLayout>
