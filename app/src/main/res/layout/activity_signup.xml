<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF2F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_signup_top">

            <View
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-70dp"
                android:layout_marginEnd="-60dp"
                android:alpha="0.10"
                android:background="@drawable/bg_circle_white" />

            <View
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="-60dp"
                android:layout_marginTop="-40dp"
                android:alpha="0.07"
                android:background="@drawable/bg_circle_white" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="64dp"
                android:paddingBottom="66dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/satoshi_medium"
                    android:letterSpacing="-0.01"
                    android:text="Create Account"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/satoshi_medium"
                    android:text="Fill in your details below"
                    android:textColor="#CFE0FF"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-34dp"
            android:background="@drawable/bg_login_card"
            android:elevation="14dp"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="24dp"
            android:paddingEnd="22dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/SignupSection"
                android:text="Personal information" />
            <LinearLayout
                android:id="@+id/llDisplayName"
                style="@style/SignupField">

                <FrameLayout style="@style/SignupChip">

                    <ImageView
                        style="@style/SignupIcon"
                        android:src="@drawable/ic_person" />
                </FrameLayout>

                <EditText
                    android:id="@+id/etDisplayName"
                    style="@style/SignupInput"
                    android:hint="Display name *"
                    android:inputType="textPersonName" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDisplayNameError"
                style="@style/SignupError" />
            <!--  Username  -->
            <LinearLayout
                android:id="@+id/llUsername"
                style="@style/SignupField">

                <FrameLayout style="@style/SignupChip">

                    <ImageView
                        style="@style/SignupIcon"
                        android:src="@drawable/ic_idcard" />
                </FrameLayout>

                <EditText
                    android:id="@+id/etUsername"
                    style="@style/SignupInput"
                    android:hint="Username *"
                    android:inputType="text" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvUsernameError"
                style="@style/SignupError" />
            <LinearLayout
                android:id="@+id/llPhone"
                style="@style/SignupField">

                <FrameLayout style="@style/SignupChip">

                    <ImageView
                        style="@style/SignupIcon"
                        android:src="@drawable/ic_phone" />
                </FrameLayout>

                <EditText
                    android:id="@+id/etPhone"
                    style="@style/SignupInput"
                    android:hint="Phone number *"
                    android:inputType="phone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPhoneError"
                style="@style/SignupError" />
            <!--  WhatsApp  -->
            <LinearLayout
                android:id="@+id/llWhatsapp"
                style="@style/SignupField">

                <FrameLayout style="@style/SignupChip">

                    <ImageView
                        style="@style/SignupIcon"
                        android:src="@drawable/ic_whatsapp" />
                </FrameLayout>

                <EditText
                    android:id="@+id/etWhatsapp"
                    style="@style/SignupInput"
                    android:hint="WhatsApp number"
                    android:inputType="phone" />
            </LinearLayout>
            <!--  Email  -->
            <LinearLayout
                android:id="@+id/llEmail"
                style="@style/SignupField">

                <FrameLayout style="@style/SignupChip">

                    <ImageView
                        style="@style/SignupIcon"
                        android:src="@drawable/ic_email" />
                </FrameLayout>

                <EditText
                    android:id="@+id/etEmail"
                    style="@style/SignupInput"
                    android:hint="Email address"
                    android:inputType="textEmailAddress" />
            </LinearLayout>
            <!--  Address  -->
            <LinearLayout
                android:id="@+id/llAddress"
                style="@style/SignupField">

                <FrameLayout style="@style/SignupChip">

                    <ImageView
                        style="@style/SignupIcon"
                        android:src="@drawable/ic_map" />
                </FrameLayout>

                <EditText
                    android:id="@+id/etAddress"
                    style="@style/SignupInput"
                    android:hint="Address"
                    android:inputType="textPostalAddress" />
            </LinearLayout>

            <TextView
                style="@style/SignupSection"
                android:layout_marginTop="18dp"
                android:text="Account setup" />
            <!--  Password  -->
            <LinearLayout
                android:id="@+id/llPassword"
                style="@style/SignupField">

                <FrameLayout style="@style/SignupChip">

                    <ImageView
                        style="@style/SignupIcon"
                        android:src="@drawable/ic_lock" />
                </FrameLayout>

                <EditText
                    android:id="@+id/etPassword"
                    style="@style/SignupInput"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="Password *"
                    android:inputType="textPassword" />

                <ImageView
                    android:id="@+id/ivTogglePassword"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_eye"
                    android:tint="#94A3B8" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPasswordError"
                style="@style/SignupError" />
            <!--  User type (keeps AutoCompleteTextView so your adapter still works)  -->
            <LinearLayout
                android:id="@+id/llUserType"
                style="@style/SignupField">

                <FrameLayout style="@style/SignupChip">

                    <ImageView
                        style="@style/SignupIcon"
                        android:src="@drawable/ic_usertype" />
                </FrameLayout>

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actvUserType"
                    style="@style/SignupInput"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:hint="User type"
                    android:inputType="none" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_chevron_down"
                    android:tint="#94A3B8" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvUserTypeError"
                style="@style/SignupError" />
            <!--  Referral  -->
            <LinearLayout
                android:id="@+id/llReferral"
                style="@style/SignupField">

                <FrameLayout style="@style/SignupChip">

                    <ImageView
                        style="@style/SignupIcon"
                        android:src="@drawable/ic_referral" />
                </FrameLayout>

                <EditText
                    android:id="@+id/etReferralId"
                    style="@style/SignupInput"
                    android:hint="Referral ID (optional)"
                    android:inputType="text" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSignUp"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_btn_primary"
                android:letterSpacing="0.04"
                android:text="CREATE ACCOUNT"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:elevation="0dp" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="14dp"
                android:indeterminateTint="#2563EB"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Already have an account? "
                    android:textColor="#475569"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvGoToLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign in"
                    android:textColor="#2563EB"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="24dp"
            android:text="EmpTrack v1.0 · © 2026"
            android:textColor="#94A3B8"
            android:textSize="11.5sp" />
    </LinearLayout>
</ScrollView>