<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog">

    <!-- Handle -->
    <View
        android:layout_width="@dimen/bottom_sheet_handle_width"
        android:layout_height="@dimen/bottom_sheet_handle_height"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/margin_md"
        android:background="@drawable/bg_sheet_handle"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_lg">

        <!-- Product + Work Name -->
        <TextView
            android:id="@+id/tvQtyProduct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_md"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_caption_small"
            android:fontFamily="@font/satoshi_bold"/>

        <!-- Rate Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_md"
            android:background="@drawable/bg_field_selector"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/padding_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rate : "
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption_vs"
                android:fontFamily="@font/satoshi_regular"/>

            <TextView
                android:id="@+id/tvQtyUnit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_caption_vs"
                android:fontFamily="@font/satoshi_bold"/>

        </LinearLayout>

        <!-- Quantity -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_md"
            android:hint="Enter quantity"
            app:boxCornerRadiusTopStart="@dimen/radius_lg"
            app:boxCornerRadiusTopEnd="@dimen/radius_lg"
            app:boxCornerRadiusBottomStart="@dimen/radius_lg"
            app:boxCornerRadiusBottomEnd="@dimen/radius_lg"
            app:boxStrokeColor="@color/primary"
            app:hintTextColor="@color/primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etQty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/satoshi_bold"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:textColor="@color/primary"
                android:textSize="22sp"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Preview -->
        <TextView
            android:id="@+id/tvQtyPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_lg"
            android:background="@drawable/bg_field_selector"
            android:padding="@dimen/padding_md"
            android:text="0 × ₹0.00 = ₹0"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_caption_small"
            android:fontFamily="@font/satoshi_bold"/>

        <!-- Save -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQtySave"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:fontFamily="@font/satoshi_bold"
            android:text="Confirm Quantity"
            android:textAllCaps="false"
            android:textSize="@dimen/text_caption_small"
            app:backgroundTint="@color/primary"
            app:cornerRadius="@dimen/radius_lg"/>

    </LinearLayout>

</LinearLayout>