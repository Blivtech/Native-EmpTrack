<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF2F8"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layoutTopbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_green"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="42dp"
        android:paddingEnd="16dp"
        android:paddingBottom="42dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_icon_btn"
            android:padding="9dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEmpTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/satoshi_medium"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmpSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/satoshi_medium"
                android:textColor="#CDEBD8"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="#2E7D32"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-30dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="96dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:orientation="horizontal">

                <LinearLayout style="@style/EmTile">

                    <TextView
                        android:id="@+id/tvSumPresent"
                        style="@style/EmTileNum"
                        android:textColor="#16A34A" />

                    <TextView
                        style="@style/EmTileLbl"
                        android:text="Present" />
                </LinearLayout>

                <View
                    android:layout_width="9dp"
                    android:layout_height="1dp" />

                <LinearLayout style="@style/EmTile">

                    <TextView
                        android:id="@+id/tvSumLeave"
                        style="@style/EmTileNum"
                        android:textColor="#DC2626" />

                    <TextView
                        style="@style/EmTileLbl"
                        android:text="Leave" />
                </LinearLayout>

                <View
                    android:layout_width="9dp"
                    android:layout_height="1dp" />

                <LinearLayout style="@style/EmTile">

                    <TextView
                        android:id="@+id/tvSumHoliday"
                        style="@style/EmTileNum"
                        android:textColor="#7C3AED" />

                    <TextView
                        style="@style/EmTileLbl"
                        android:text="Holiday" />
                </LinearLayout>

                <View
                    android:layout_width="9dp"
                    android:layout_height="1dp" />

                <LinearLayout style="@style/EmTile">

                    <TextView
                        android:id="@+id/tvSumWeekOff"
                        style="@style/EmTileNum"
                        android:textColor="#334155" />

                    <TextView
                        style="@style/EmTileLbl"
                        android:text="Week Off" />
                </LinearLayout>
            </LinearLayout>

            <!-- Employee card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="15dp">

                <TextView
                    android:id="@+id/tvAvatar"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="13dp"
                    android:background="@drawable/bg_avatar"
                    android:fontFamily="@font/satoshi_medium"
                    android:gravity="center"
                    android:textColor="#27500A"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvEmpName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/satoshi_medium"
                        android:textColor="#0F172A"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvEmpMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/satoshi_medium"
                        android:textColor="#94A3B8"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tvShift"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/bg_shift_chip"
                        android:fontFamily="@font/satoshi_medium"
                        android:paddingStart="12dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="3dp"
                        android:textColor="#1D4ED8"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_att"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="9dp">

                    <TextView
                        android:id="@+id/tvAttendance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/satoshi_medium"
                        android:textColor="#DC2626"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="@font/satoshi_medium"
                        android:text="Attendance"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Present -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="14dp"
                android:orientation="vertical">

                <LinearLayout style="@style/EmSecHead">

                    <TextView
                        style="@style/EmSecDot"
                        android:background="@drawable/bg_dot_green"
                        android:text="✓" />

                    <TextView
                        android:id="@+id/tvPresentTitle"
                        style="@style/EmSecTitle"
                        android:text="Present Dates (0)"
                        android:textColor="#15803D" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutPresentChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvPresentEmpty"
                    style="@style/EmEmpty"
                    android:text="No dates in this category 🎉"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Absent -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="14dp"
                android:orientation="vertical">

                <LinearLayout style="@style/EmSecHead">

                    <TextView
                        style="@style/EmSecDot"
                        android:background="@drawable/bg_dot_red"
                        android:text="✕" />

                    <TextView
                        android:id="@+id/tvAbsentTitle"
                        style="@style/EmSecTitle"
                        android:text="Absent Dates (0)"
                        android:textColor="#B91C1C" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutAbsentChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvAbsentEmpty"
                    style="@style/EmEmpty"
                    android:text="No dates in this category 🎉"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Holiday + Week Off -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="14dp"
                android:orientation="vertical">

                <LinearLayout style="@style/EmSecHead">

                    <TextView
                        style="@style/EmSecDot"
                        android:background="@drawable/bg_dot_violet"
                        android:text="⛱" />

                    <TextView
                        android:id="@+id/tvHwoTitle"
                        style="@style/EmSecTitle"
                        android:text="Holiday + Week Off (0)"
                        android:textColor="#6D28D9" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutHwoChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvHwoEmpty"
                    style="@style/EmEmpty"
                    android:text="No dates in this category 🎉"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Export bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="10dp"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/btnPdf"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_export_pdf"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/satoshi_medium"
            android:gravity="center"
            android:text="PDF"
            android:textColor="#C62828"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnExcel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_export_xls"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/satoshi_medium"
            android:gravity="center"
            android:text="Excel"
            android:textColor="#15803D"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnShare"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/satoshi_medium"
            android:gravity="center"
            android:text="Share"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>