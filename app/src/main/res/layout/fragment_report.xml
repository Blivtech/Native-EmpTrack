<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EEF2F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_header"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reports"
            android:textSize="24sp"
            android:fontFamily="@font/satoshi_medium"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/tvCompanyName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13.5sp"
            android:letterSpacing="0.03"
            android:fontFamily="@font/satoshi_medium"
            android:textColor="#CFE0FF"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Quick stats strip (kept for binding; hidden) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:background="#0C447C"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center"
            android:background="@drawable/bg_circle_white15" android:padding="8dp" android:layout_marginEnd="5dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="7" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Reports" android:textSize="7sp" android:textColor="#88FFFFFF"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center"
            android:background="@drawable/bg_circle_white15" android:padding="8dp" android:layout_marginEnd="5dp">
            <TextView android:id="@+id/tvTotalPresent" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textSize="16sp" android:textStyle="bold" android:textColor="#69F0AE"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Present" android:textSize="7sp" android:textColor="#88FFFFFF"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center"
            android:background="@drawable/bg_circle_white15" android:padding="8dp">
            <TextView android:id="@+id/tvTotalAbsent" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textSize="16sp" android:textStyle="bold" android:textColor="#FF8A80"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Absent" android:textSize="7sp" android:textColor="#88FFFFFF"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reports"
                android:textSize="15sp"
                android:fontFamily="@font/satoshi_medium"
                android:textStyle="bold"
                android:textColor="#475569"
                android:letterSpacing="0.02"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="12dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvReports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"/>

            <View android:layout_width="match_parent" android:layout_height="24dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>