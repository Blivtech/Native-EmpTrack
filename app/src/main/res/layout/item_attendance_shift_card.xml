<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardShift"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="13dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:strokeWidth="0dp"
    app:strokeColor="#E0E0E0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/layoutShiftIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:background="@drawable/bg_shift_chip"
                android:layout_marginEnd="12dp">
                <ImageView
                    android:id="@+id/ivShiftIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_calendar"
                    android:tint="#2563EB"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvShiftName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/satoshi_medium"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"/>

                <TextView
                    android:id="@+id/tvShiftTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/satoshi_medium"
                    android:textColor="#475569"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:drawableStart="@drawable/ic_clock"
                    android:drawableTint="#94A3B8"
                    android:drawablePadding="5dp"
                    android:layout_marginTop="3dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvShiftBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"/>
        </LinearLayout>

        <!-- Count text -->
        <TextView
            android:id="@+id/tvShiftCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/satoshi_medium"
            android:textStyle="bold"
            android:textSize="12.5sp"
            android:layout_marginTop="14dp"/>

        <!-- Progress -->
        <ProgressBar
            android:id="@+id/progShift"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:progressDrawable="@drawable/progress_shift"
            android:layout_marginTop="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMarkAttendance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mark now"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:minHeight="50dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginTop="14dp"
            app:cornerRadius="14dp"
            app:elevation="0dp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>