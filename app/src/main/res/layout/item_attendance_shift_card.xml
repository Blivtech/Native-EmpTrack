<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Shift top row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <!-- Shift icon -->
            <LinearLayout
                android:id="@+id/layoutShiftIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:background="@drawable/bg_shift_morning"
                android:layout_marginEnd="10dp">
                <ImageView
                    android:id="@+id/ivShiftIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@android:drawable/ic_menu_day"
                    android:tint="#27500A"/>
            </LinearLayout>

            <!-- Shift info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvShiftName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#212121"/>

                <TextView
                    android:id="@+id/tvShiftTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="#757575"
                    android:layout_marginTop="1dp"/>
            </LinearLayout>

            <!-- Status badge -->
            <TextView
                android:id="@+id/tvShiftBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="@drawable/bg_badge_blue"
                android:textColor="#0C447C"
                android:text="Not marked"/>
        </LinearLayout>

        <!-- Progress bar -->
        <ProgressBar
            android:id="@+id/progShift"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:progress="0"
            android:max="100"
            android:progressDrawable="@drawable/progress_drawable"
            android:layout_marginBottom="8dp"/>

        <!-- Count + Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvShiftCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:textColor="#757575"
                android:text="Tap to mark attendance"/>

            <Button
                android:id="@+id/btnMarkAttendance"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Mark now"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:backgroundTint="#1565C0"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>