<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1565C0"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="48dp"
        android:paddingEnd="16dp"
        android:paddingBottom="22dp">

        <TextView
            android:id="@+id/tvDrawerAvatar"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/bg_avatar"
            android:gravity="center"
            android:text="SR"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDrawerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/satoshi_medium"
                android:text="Saravanan R"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDrawerPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="BT0005"
                android:textColor="#CFE0FF"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/tvDrawerCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="BT0005 · Admin"
                android:textColor="#CFE0FF"
                android:textSize="12.5sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivDrawerClose"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_circle_white"
            android:padding="7dp"
            android:src="@drawable/ic_close"
            android:tint="#FFFFFF" />
    </LinearLayout>
    <!--  ───────── Menu rows ─────────  -->
    <LinearLayout
        android:id="@+id/menuSync"
        style="@style/DrawerRow">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_drawer_chip"
            android:backgroundTint="#E7F0FF">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_sync"
                android:tint="#2563EB" />
        </FrameLayout>

        <LinearLayout style="@style/DrawerRowText">

            <TextView
                style="@style/DrawerTitle"
                android:text="Sync data" />

            <TextView
                style="@style/DrawerSub"
                android:text="Last synced: just now" />
        </LinearLayout>

        <ImageView style="@style/DrawerChevron" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menuProfile"
        style="@style/DrawerRow">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_drawer_chip"
            android:backgroundTint="#EAF7EF">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_profile"
                android:tint="#16A34A" />
        </FrameLayout>

        <LinearLayout style="@style/DrawerRowText">

            <TextView
                style="@style/DrawerTitle"
                android:text="My profile" />

            <TextView
                style="@style/DrawerSub"
                android:text="View  edit profile" />
        </LinearLayout>

        <ImageView style="@style/DrawerChevron" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menuCompanies"
        style="@style/DrawerRow">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_drawer_chip"
            android:backgroundTint="#FEF3E2">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_company"
                android:tint="#D97706" />
        </FrameLayout>

        <LinearLayout style="@style/DrawerRowText">

            <TextView
                style="@style/DrawerTitle"
                android:text="Companies" />

            <TextView
                style="@style/DrawerSub"
                android:text="Manage  switch company" />
        </LinearLayout>

        <ImageView style="@style/DrawerChevron" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menuSettings"
        style="@style/DrawerRow">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_drawer_chip"
            android:backgroundTint="#E7F0FF">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_settings"
                android:tint="#2563EB" />
        </FrameLayout>

        <LinearLayout style="@style/DrawerRowText">

            <TextView
                style="@style/DrawerTitle"
                android:text="Settings" />

            <TextView
                style="@style/DrawerSub"
                android:text="App preferences" />
        </LinearLayout>

        <ImageView style="@style/DrawerChevron" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="8dp"
        android:background="#E7ECF3" />

    <LinearLayout
        android:id="@+id/menuHelp"
        style="@style/DrawerRow">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_drawer_chip"
            android:backgroundTint="#F1F5F9">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_help"
                android:tint="#64748B" />
        </FrameLayout>

        <LinearLayout style="@style/DrawerRowText">

            <TextView
                style="@style/DrawerTitle"
                android:text="Help  support" />

            <TextView
                style="@style/DrawerSub"
                android:text="FAQ · Contact us" />
        </LinearLayout>

        <ImageView style="@style/DrawerChevron" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menuAbout"
        style="@style/DrawerRow">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_drawer_chip"
            android:backgroundTint="#F1F5F9">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_settings"
                android:tint="#64748B" />
        </FrameLayout>

        <LinearLayout style="@style/DrawerRowText">

            <TextView
                style="@style/DrawerTitle"
                android:text="About Us" />

            <TextView
                style="@style/DrawerSub"
                android:text="View Us" />
        </LinearLayout>

        <ImageView style="@style/DrawerChevron" />
    </LinearLayout>
    <!--  push logout to the bottom  -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <!--  ───────── Logout ─────────  -->
    <LinearLayout
        android:id="@+id/layoutLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:background="@drawable/bg_logout"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="15dp">

        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_logout"
            android:tint="#DC2626" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:textColor="#DC2626"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="18dp"
        android:text="EmpTrack v1.0 · © 2026"
        android:textColor="#94A3B8"
        android:textSize="11.5sp" />
</LinearLayout>