<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <!-- Blue Header -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1565C0"
        android:padding="16dp"
        android:paddingBottom="22dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Top row: greeting + buttons -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:id="@+id/layoutGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Good morning,"
                    android:fontFamily="@font/satoshi_medium"
                    android:textSize="@dimen/text_caption_vs"
                    android:textColor="#B3ffffff"/>

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Saravanan R"
                    android:fontFamily="@font/satoshi_medium"
                    android:textSize="@dimen/text_caption_lg"                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="1dp"/>
            </LinearLayout>

            <!-- Avatar -->
            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="SR"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_avatar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <!-- Notification -->
            <ImageView
                android:id="@+id/ivNotification"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_popup_reminder"
                android:tint="#FFFFFF"
                android:background="@drawable/bg_circle_white"
                android:padding="9dp"
                app:layout_constraintEnd_toStartOf="@id/tvAvatar"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginEnd="8dp"/>

            <!-- Sync -->
            <ImageView
                android:id="@+id/ivSync"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_nav_home"
                android:tint="#FFFFFF"
                android:visibility="gone"
                android:background="@drawable/bg_circle_white"
                android:padding="9dp"
                app:layout_constraintEnd_toStartOf="@id/ivNotification"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginEnd="8dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Company selector -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutCompany"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_company_pill"
            android:padding="9dp"
            android:layout_marginBottom="14dp">

            <ImageView
                android:id="@+id/ivCompanyIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@android:drawable/ic_dialog_map"
                android:tint="#CCffffff"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginEnd="8dp"/>

            <LinearLayout
                android:id="@+id/layoutCompanyText"
                android:layout_width="0dp"
                app:layout_goneMarginStart="5dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintStart_toEndOf="@id/ivCompanyIcon"
                app:layout_constraintEnd_toStartOf="@id/ivCompanyArrow"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active company"
                    android:textSize="@dimen/text_caption_small"
                    android:fontFamily="@font/satoshi_medium"
                    android:textColor="#99ffffff"/>

                <TextView
                    android:id="@+id/tvCompanyName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:textSize="@dimen/text_caption_md"
                    android:fontFamily="@font/satoshi_medium"                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="1dp"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/ivCompanyArrow"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:tint="#80ffffff"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Stats row -->
        <LinearLayout
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="4">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_stat_pill"
                android:padding="8dp"
                android:layout_marginEnd="5dp">
                <TextView android:id="@+id/tvTotalEmp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="18sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Employees" android:textSize="9sp" android:textColor="#99ffffff"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_stat_pill"
                android:padding="8dp"
                android:layout_marginEnd="5dp">
                <TextView android:id="@+id/tvPresent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="18sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Present" android:textSize="9sp" android:textColor="#99ffffff"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_stat_pill"
                android:padding="8dp"
                android:layout_marginEnd="5dp">
                <TextView android:id="@+id/tvPartial" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="18sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Partial" android:textSize="9sp" android:textColor="#99ffffff"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_stat_pill"
                android:padding="8dp">
                <TextView android:id="@+id/tvAbsent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="18sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Absent" android:textSize="9sp" android:textColor="#99ffffff"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable content -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Quick Modules"
                android:textColor="#212121"
                android:textSize="@dimen/text_caption_md"
                android:fontFamily="@font/satoshi_medium"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvModules"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:overScrollMode="never"
            android:layout_marginBottom="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>