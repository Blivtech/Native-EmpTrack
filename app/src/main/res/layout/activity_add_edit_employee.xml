<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:orientation="vertical">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1565C0"
        android:padding="15dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Add employee"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_caption_th"
            android:textStyle="bold"
            android:fontFamily="@font/satoshi_medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivBack"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ═══════════════════════════════ -->
    <!-- SCROLLABLE CONTENT              -->
    <!-- ═══════════════════════════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="4dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:text="Personal information"
                        android:fontFamily="@font/satoshi_medium"

                        android:textColor="#1565C0"
                        android:textSize="@dimen/text_caption_lg"
                        android:textStyle="bold" />

                    <!-- Full Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:fontFamily="@font/satoshi_medium"

                        android:text="Full name *"
                        android:textColor="#757575"
                        android:textSize="@dimen/text_caption_md"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etName"
                        android:fontFamily="@font/satoshi_medium"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_search"
                        android:drawableStart="@android:drawable/ic_menu_myplaces"
                        android:drawableTint="#1565C0"
                        android:gravity="center_vertical"
                        android:hint="Enter full name"
                        android:imeOptions="actionNext"
                        android:inputType="textPersonName"
                        android:textColor="#212121"
                        android:textSize="@dimen/text_caption_md" />

                    <!-- Phone -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Phone *"
                        android:fontFamily="@font/satoshi_medium"

                        android:textColor="#757575"
                        android:textSize="@dimen/text_caption_md"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_search"
                        android:drawableStart="@android:drawable/ic_menu_call"
                        android:drawableTint="#1565C0"
                        android:padding="10dp"
                        android:fontFamily="@font/satoshi_medium"

                        android:gravity="center_vertical"
                        android:hint="Phone number"
                        android:textSize="@dimen/text_caption_md"
                        android:inputType="phone"
                        android:imeOptions="actionNext"
                        android:textColor="#212121"
                        />

                    <!-- Gender trigger -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Gender"
                        android:fontFamily="@font/satoshi_medium"

                        android:textColor="#757575"
                        android:textSize="@dimen/text_caption_md"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/layoutGenderTrigger"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_field_trigger"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="10dp"
                            android:src="@android:drawable/ic_menu_myplaces"
                            android:tint="#9E9E9E" />

                        <TextView
                            android:id="@+id/tvGenderValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/satoshi_medium"

                            android:layout_weight="1"
                            android:text="Select gender"
                            android:textColor="#9E9E9E"
                            android:textSize="@dimen/text_caption_md" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/arrow_down_float"
                            android:tint="#BDBDBD" />
                    </LinearLayout>

                    <!-- Email -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Email"
                        android:fontFamily="@font/satoshi_medium"

                        android:textColor="#757575"
                        android:textSize="@dimen/text_caption_md"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_search"
                        android:drawableStart="@android:drawable/ic_dialog_email"
                        android:drawableTint="#1565C0"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:hint="Email address"
                        android:padding="10dp"
                        android:textSize="@dimen/text_caption_md"
                        android:fontFamily="@font/satoshi_medium"
                        android:inputType="textEmailAddress"
                        android:imeOptions="actionNext"
                        android:textColor="#212121"
                        />

                    <!-- DOB & Joining Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- DOB -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:text="Date of birth"
                                android:fontFamily="@font/satoshi_medium"

                                android:textColor="#757575"
                                android:textSize="@dimen/text_caption_lg"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:id="@+id/layoutDobTrigger"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_field_trigger"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="10dp">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginEnd="6dp"
                                    android:src="@android:drawable/ic_menu_my_calendar"
                                    android:tint="#9E9E9E" />

                                <TextView
                                    android:id="@+id/tvDobValue"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="DD/MM/YYYY"
                                    android:textColor="#9E9E9E"
                                    android:fontFamily="@font/satoshi_medium"

                                    android:textSize="@dimen/text_caption_md" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Joining Date -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:text="Joining date"
                                android:fontFamily="@font/satoshi_medium"

                                android:textColor="#757575"
                                android:textSize="@dimen/text_caption_md"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:id="@+id/layoutJoiningTrigger"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_field_trigger"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="10dp">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginEnd="6dp"
                                    android:src="@android:drawable/ic_menu_my_calendar"
                                    android:tint="#9E9E9E" />

                                <TextView
                                    android:id="@+id/tvJoiningValue"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="DD/MM/YYYY"
                                    android:textColor="#9E9E9E"
                                    android:fontFamily="@font/satoshi_medium"

                                    android:textSize="@dimen/text_caption_md" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="4dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:text="Job information"
                        android:textColor="#1565C0"
                        android:fontFamily="@font/satoshi_medium"

                        android:textSize="@dimen/text_caption_lg"
                        android:textStyle="bold" />

                    <!-- Company (locked) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Company"
                        android:fontFamily="@font/satoshi_medium"

                        android:textColor="#757575"
                        android:textSize="@dimen/text_caption_md"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_field_selected"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="10dp"
                            android:src="@android:drawable/ic_dialog_map"
                            android:tint="#0C447C" />

                        <TextView
                            android:id="@+id/tvCompanyValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="#0C447C"
                            android:textSize="@dimen/text_caption_md"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/ic_lock_idle_lock"
                            android:tint="#BDBDBD" />
                    </LinearLayout>

                    <!-- Department & Designation Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Department -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:text="Department *"
                                android:fontFamily="@font/satoshi_medium"

                                android:textColor="#757575"
                                android:textSize="@dimen/text_caption_md"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:id="@+id/layoutDeptTrigger"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_field_trigger"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="10dp">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginEnd="6dp"
                                    android:src="@android:drawable/ic_menu_myplaces"
                                    android:tint="#9E9E9E" />

                                <TextView
                                    android:id="@+id/tvDeptValue"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Select"
                                    android:textColor="#9E9E9E"
                                    android:fontFamily="@font/satoshi_medium"

                                    android:textSize="@dimen/text_caption_md" />

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@android:drawable/arrow_down_float"
                                    android:tint="#BDBDBD" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Designation -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:text="Designation *"
                                android:textColor="#757575"
                                android:textSize="@dimen/text_caption_md"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:id="@+id/layoutDesgTrigger"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_field_trigger"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="10dp">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginEnd="6dp"
                                    android:src="@android:drawable/ic_menu_myplaces"
                                    android:tint="#9E9E9E" />

                                <TextView
                                    android:id="@+id/tvDesgValue"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Select"
                                    android:textColor="#9E9E9E"
                                    android:fontFamily="@font/satoshi_medium"

                                    android:textSize="@dimen/text_caption_md" />

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@android:drawable/arrow_down_float"
                                    android:tint="#BDBDBD" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="4dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:text="Salary information"
                        android:textColor="#1565C0"
                        android:textSize="@dimen/text_caption_lg"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Salary type &amp; amount"
                        android:fontFamily="@font/satoshi_medium"

                        android:textColor="#757575"
                        android:textSize="@dimen/text_caption_md"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/layoutSalaryTrigger"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_field_trigger"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="10dp"
                            android:src="@android:drawable/ic_menu_myplaces"
                            android:tint="#9E9E9E" />

                        <TextView
                            android:id="@+id/tvSalaryValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/satoshi_medium"

                            android:text="Tap to set salary"
                            android:textColor="#9E9E9E"
                            android:textSize="@dimen/text_caption_md" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/arrow_down_float"
                            android:tint="#BDBDBD" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save employee"
                android:fontFamily="@font/satoshi_medium"

                android:textSize="@dimen/text_caption_lg"
                android:textStyle="bold"
                app:backgroundTint="#1565C0"
                app:cornerRadius="4dp" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:indeterminateTint="#1565C0"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>