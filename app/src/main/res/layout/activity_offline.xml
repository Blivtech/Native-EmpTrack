<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <!-- Top Blue Wave -->
    <View
        android:id="@+id/viewTopBg"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:background="@drawable/bg_gradient"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Decorative circle -->
    <View
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:background="@drawable/bg_circle_white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-60dp"
        android:layout_marginEnd="-60dp"/>

    <!-- Offline Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardOffline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="36dp">

            <!-- Offline Icon -->
            <ImageView
                android:id="@+id/ivOffline"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_offline"
                android:alpha="0"/>

            <!-- No Internet Title -->
            <TextView
                android:id="@+id/tvOfflineTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Internet Connection"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:layout_marginTop="24dp"
                android:alpha="0"/>

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tvOfflineSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Please check your Wi-Fi or mobile data\nand try again."
                android:textSize="14sp"
                android:textColor="#757575"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="12dp"
                android:alpha="0"/>

            <!-- Divider -->
            <View
                android:layout_width="60dp"
                android:layout_height="3dp"
                android:background="#1565C0"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"/>

            <!-- Tips -->
            <LinearLayout
                android:id="@+id/layoutTips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F0F4FF"
                android:padding="16dp"
                android:layout_marginBottom="24dp"
                android:alpha="0">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 Quick Tips"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Turn Airplane mode OFF"
                    android:textSize="13sp"
                    android:textColor="#424242"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Enable Wi-Fi or Mobile Data"
                    android:textSize="13sp"
                    android:textColor="#424242"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Move to a better signal area"
                    android:textSize="13sp"
                    android:textColor="#424242"/>
            </LinearLayout>

            <!-- Retry Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Try Again"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:backgroundTint="#1565C0"
                app:icon="@android:drawable/ic_popup_sync"
                app:iconGravity="start"
                app:iconTint="@color/white"/>

            <!-- Open Settings -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenSettings"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Open Settings"
                android:textColor="#1565C0"
                android:textSize="15sp"
                app:cornerRadius="14dp"
                app:strokeColor="#1565C0"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>