<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="13dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#2563EB"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCompanyInitial"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:gravity="center"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#1D4ED8"
                android:background="@drawable/bg_company_ava"
                android:layout_marginEnd="13dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCompanyName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/satoshi_medium"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"/>

                <TextView
                    android:id="@+id/tvCompanyCity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/satoshi_medium"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="#475569"
                    android:drawableStart="@drawable/ic_pin"
                    android:drawableTint="#94A3B8"
                    android:drawablePadding="5dp"
                    android:layout_marginTop="5dp"/>

                <TextView
                    android:id="@+id/tvCompanyPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/satoshi_medium"
                    android:textSize="12.5sp"
                    android:textColor="#94A3B8"
                    android:drawableStart="@drawable/ic_phone"
                    android:drawableTint="#94A3B8"
                    android:drawablePadding="5dp"
                    android:layout_marginTop="3dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ivEdit"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_edit"
                    android:tint="#2563EB"
                    android:background="@drawable/bg_circle_blue"
                    android:padding="10dp"
                    android:layout_marginEnd="8dp"/>

                <ImageView
                    android:id="@+id/ivDelete"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_delete"
                    android:tint="#DC2626"
                    android:background="@drawable/bg_circle_red"
                    android:padding="10dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Shift chips (built in adapter) -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupShifts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:chipSpacingVertical="6dp"
            app:chipSpacingHorizontal="8dp"/>

        <!-- Active indicator (adapter toggles visibility) -->
        <LinearLayout
            android:id="@+id/layoutSelected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_active_pill"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_check"
                android:tint="#2563EB"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active company"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:fontFamily="@font/satoshi_medium"
                android:textColor="#2563EB"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>