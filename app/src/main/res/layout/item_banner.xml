<?xml version="1.0" encoding="utf-8"?>
<!-- Root background is set per-item in BannerAdapter (bg_banner_blue/teal/purple) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bannerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/tvBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEW"
        android:textAllCaps="true"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:alpha="0.85"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvBannerTitle"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:text="Monthly reports, one tap"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="@font/satoshi_medium"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/tvBannerSub"
        android:layout_width="230dp"
        android:layout_height="wrap_content"
        android:text="Export attendance and piece-rate pay."
        android:textSize="12sp"
        android:alpha="0.9"
        android:textColor="#FFFFFF"
        android:layout_marginTop="5dp" />

    <TextView
        android:id="@+id/tvBannerCta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Try it"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#111111"
        android:background="@drawable/bg_pill_white"
        android:paddingHorizontal="15dp"
        android:paddingVertical="8dp"
        android:layout_marginTop="12dp" />
</LinearLayout>