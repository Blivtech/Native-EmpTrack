<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1565C0"
        android:padding="14dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_nav_home"
                android:tint="#FFFFFF"
                android:padding="4dp"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mark Attendance"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/tvProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/0"
                android:textSize="12sp"
                android:textColor="#CCffffff"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_company_pill"
            android:padding="9dp">

            <LinearLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:background="@drawable/bg_circle_white"
                android:layout_marginEnd="10dp">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_day"
                    android:tint="#1565C0"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvShiftBanner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:id="@+id/tvShiftTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="#CCffffff"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/btnDeviation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deviation"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_stat_pill"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_marginStart="6dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/btnPrefill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prefill"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#412402"
                android:background="@drawable/bg_badge_amber"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_marginStart="6dp"
                android:visibility="gone"/>

        </LinearLayout>
    </LinearLayout>


    <LinearLayout
        android:id="@+id/layoutPrefillBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_badge_amber"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@android:drawable/ic_menu_recent_history"
            android:tint="#633806"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pre-filled from yesterday's attendance"
            android:textSize="11sp"
            android:textColor="#633806"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#854F0B"/>
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@android:drawable/ic_menu_search"
            android:tint="#BDBDBD"
            android:layout_marginEnd="8dp"/>

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:hint="Search name or emp code..."
            android:textSize="12sp"
            android:textColor="#212121"
            android:textColorHint="#BDBDBD"
            android:background="@null"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text"/>

        <ImageView
            android:id="@+id/ivClearSearch"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#BDBDBD"
            android:visibility="gone"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#E0E0E0"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp"
            android:gravity="center_vertical">

            <!-- ✅ Pending tab — default active -->
            <TextView
                android:id="@+id/tabUnselected"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="Pending (0)"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_tab_active"
                android:textColor="@color/blue_dark"/>

            <!-- All tab -->
            <TextView
                android:id="@+id/tabAll"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="All (0)"
                android:textSize="11sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_tab_inactive"
                android:textColor="#757575"/>

            <!-- Working tab -->
            <TextView
                android:id="@+id/tabWorking"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="Working (0)"
                android:textSize="11sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_tab_inactive"
                android:textColor="#757575"/>

            <!-- Off tab -->
            <TextView
                android:id="@+id/tabWeekoff"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="Off (0)"
                android:textSize="11sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_tab_inactive"
                android:textColor="#757575"/>

            <!-- Leave tab -->
            <TextView
                android:id="@+id/tabLeave"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="Leave (0)"
                android:textSize="11sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_tab_inactive"
                android:textColor="#757575"/>

            <!-- Holiday tab -->
            <TextView
                android:id="@+id/tabHoliday"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="Holiday (0)"
                android:textSize="11sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_tab_inactive"
                android:textColor="#757575"/>

        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#E0E0E0"/>

    <!-- ═══════════════════════════════ -->
    <!-- EMPLOYEE LIST                   -->
    <!-- ═══════════════════════════════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEmployees"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="10dp"
        android:clipToPadding="false"
        android:scrollbars="none"/>

    <!-- ═══════════════════════════════ -->
    <!-- EMPTY STATE                     -->
    <!-- ═══════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="30dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@android:drawable/ic_menu_agenda"
            android:tint="#BDBDBD"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No employees in shift plan"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#9E9E9E"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Assign employees to this shift first"
            android:textSize="12sp"
            android:textColor="#BDBDBD"
            android:layout_marginTop="6dp"/>

    </LinearLayout>

    <!-- ═══════════════════════════════ -->
    <!-- BOTTOM BAR                      -->
    <!-- ═══════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:elevation="8dp">

        <!-- Count grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="5"
            android:layout_marginBottom="10dp">

            <!-- Working count -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tvCountWorking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#27500A"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Working"
                    android:textSize="9sp"
                    android:textColor="#757575"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- Off count -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tvCountWeekoff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#633806"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Off"
                    android:textSize="9sp"
                    android:textColor="#757575"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- Leave count -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tvCountLeave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#0C447C"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Leave"
                    android:textSize="9sp"
                    android:textColor="#757575"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- Holiday count -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tvCountHoliday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#3C3489"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Holiday"
                    android:textSize="9sp"
                    android:textColor="#757575"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- Pending count -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tvCountPending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#E24B4A"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pending"
                    android:textSize="9sp"
                    android:textColor="#757575"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- ✅ Submit button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Submit attendance →"
            android:textSize="14sp"
            android:textStyle="bold"
            android:enabled="false"
            app:cornerRadius="12dp"
            app:backgroundTint="#BDBDBD"/>

    </LinearLayout>

</LinearLayout>