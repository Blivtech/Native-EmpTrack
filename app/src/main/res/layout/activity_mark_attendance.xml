<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#EEF2F8">

    <com.facebook.shimmer.ShimmerFrameLayout android:id="@+id/shimmerLayout"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        app:shimmer_duration="1000" app:shimmer_base_color="#F0F0F0" app:shimmer_highlight_color="#FFFFFF" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <include layout="@layout/layout_shimmer_list"/><include layout="@layout/layout_shimmer_list"/>
            <include layout="@layout/layout_shimmer_list"/><include layout="@layout/layout_shimmer_list"/>
            <include layout="@layout/layout_shimmer_list"/><include layout="@layout/layout_shimmer_list"/>
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <LinearLayout android:id="@+id/layoutMain" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:background="#EEF2F8">

        <!-- Header -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/bg_header_att" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="42dp" android:paddingBottom="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp">
                <ImageView android:id="@+id/ivBack" android:layout_width="36dp" android:layout_height="36dp"
                    android:src="@drawable/ic_arrow_back" android:tint="#FFFFFF" android:padding="8dp" android:background="@drawable/bg_icon_btn" android:layout_marginEnd="12dp" android:clickable="true" android:focusable="true"/>
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Mark Attendance"
                    android:fontFamily="@font/satoshi_medium" android:textSize="20sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
                <TextView android:id="@+id/tvProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0/0"
                    android:fontFamily="@font/satoshi_medium" android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFF"
                    android:background="@drawable/bg_stat_pill" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="center_vertical" android:background="@drawable/bg_company_pill" android:padding="12dp">
                <LinearLayout android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:background="@drawable/bg_circle_white" android:layout_marginEnd="11dp">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@android:drawable/ic_menu_day" android:tint="#1D4ED8"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/tvShiftBanner" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="@font/satoshi_medium" android:textSize="14.5sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
                    <TextView android:id="@+id/tvShiftTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="@font/satoshi_medium" android:textSize="12sp" android:textColor="#CFE0FF" android:layout_marginTop="2dp"/>
                </LinearLayout>
                <TextView android:id="@+id/btnDeviation" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Deviation"
                    android:fontFamily="@font/satoshi_medium" android:textSize="12.5sp" android:textStyle="bold" android:textColor="#FFFFFF"
                    android:background="@drawable/bg_stat_pill" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_marginStart="6dp"/>
                <TextView android:id="@+id/btnPrefill" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Prefill"
                    android:fontFamily="@font/satoshi_medium" android:textSize="12sp" android:textStyle="bold" android:textColor="#412402"
                    android:background="@drawable/bg_badge_amber" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_marginStart="6dp" android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Prefill banner -->
        <LinearLayout android:id="@+id/layoutPrefillBanner" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:background="#FEF3C7"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="9dp" android:paddingBottom="9dp" android:visibility="gone">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@android:drawable/ic_menu_recent_history" android:tint="#B45309" android:layout_marginEnd="8dp"/>
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Pre-filled from yesterday's attendance"
                android:fontFamily="@font/satoshi_medium" android:textSize="12sp" android:textStyle="bold" android:textColor="#854F0B"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Edit" android:textStyle="bold" android:textColor="#854F0B" android:textSize="12sp"/>
        </LinearLayout>

        <!-- Search -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:background="#FFFFFF" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="11dp" android:paddingBottom="11dp">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@android:drawable/ic_menu_search" android:tint="#94A3B8" android:layout_marginEnd="10dp"/>
            <EditText android:id="@+id/etSearch" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:hint="Search name or emp code..." android:fontFamily="@font/satoshi_medium" android:textSize="14.5sp" android:textColor="#0F172A" android:textColorHint="#94A3B8"
                android:background="@null" android:singleLine="true" android:imeOptions="actionSearch" android:inputType="text"/>
            <ImageView android:id="@+id/ivClearSearch" android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_close_clear_cancel" android:tint="#94A3B8" android:visibility="gone"/>
        </LinearLayout>

        <!-- Filter tabs -->
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:background="#FFFFFF">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="8dp" android:paddingTop="4dp" android:gravity="center_vertical">
                <TextView android:id="@+id/tabUnselected" style="@style/AttTab" android:text="Pending (0)" android:background="@drawable/bg_tab_active" android:textColor="@color/blue_dark"/>
                <TextView android:id="@+id/tabAll" style="@style/AttTab" android:text="All (0)" android:background="@drawable/bg_tab_inactive" android:textColor="#64748B"/>
                <TextView android:id="@+id/tabWorking" style="@style/AttTab" android:text="Working (0)" android:background="@drawable/bg_tab_inactive" android:textColor="#64748B"/>
                <TextView android:id="@+id/tabWeekoff" style="@style/AttTab" android:text="Off (0)" android:background="@drawable/bg_tab_inactive" android:textColor="#64748B"/>
                <TextView android:id="@+id/tabLeave" style="@style/AttTab" android:text="Leave (0)" android:background="@drawable/bg_tab_inactive" android:textColor="#64748B"/>
                <TextView android:id="@+id/tabHoliday" style="@style/AttTab" android:text="Holiday (0)" android:background="@drawable/bg_tab_inactive" android:textColor="#64748B" android:layout_marginEnd="0dp"/>
            </LinearLayout>
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvEmployees"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:padding="14dp" android:clipToPadding="false" android:scrollbars="none"/>

        <LinearLayout android:id="@+id/layoutEmpty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:padding="30dp" android:visibility="gone">
            <ImageView android:layout_width="56dp" android:layout_height="56dp" android:src="@android:drawable/ic_menu_agenda" android:tint="#CBD5E1" android:layout_marginBottom="12dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No employees in shift plan"
                android:fontFamily="@font/satoshi_medium" android:textSize="15sp" android:textStyle="bold" android:textColor="#94A3B8"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Assign employees to this shift first"
                android:fontFamily="@font/satoshi_medium" android:textSize="12sp" android:textColor="#CBD5E1" android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- Bottom bar -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="#FFFFFF" android:padding="14dp" android:elevation="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="5" android:layout_marginBottom="12dp">
                <LinearLayout style="@style/AttCount"><TextView android:id="@+id/tvCountWorking" style="@style/AttCountNum" android:textColor="#16A34A"/><TextView style="@style/AttCountLbl" android:text="Working"/></LinearLayout>
                <LinearLayout style="@style/AttCount"><TextView android:id="@+id/tvCountWeekoff" style="@style/AttCountNum" android:textColor="#D97706"/><TextView style="@style/AttCountLbl" android:text="Off"/></LinearLayout>
                <LinearLayout style="@style/AttCount"><TextView android:id="@+id/tvCountLeave" style="@style/AttCountNum" android:textColor="#2563EB"/><TextView style="@style/AttCountLbl" android:text="Leave"/></LinearLayout>
                <LinearLayout style="@style/AttCount"><TextView android:id="@+id/tvCountHoliday" style="@style/AttCountNum" android:textColor="#7C3AED"/><TextView style="@style/AttCountLbl" android:text="Holiday"/></LinearLayout>
                <LinearLayout style="@style/AttCount"><TextView android:id="@+id/tvCountPending" style="@style/AttCountNum" android:textColor="#DC2626"/><TextView style="@style/AttCountLbl" android:text="Pending"/></LinearLayout>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSubmit"
                android:layout_width="match_parent" android:layout_height="54dp" android:text="Submit attendance →"
                android:textSize="15.5sp" android:fontFamily="@font/satoshi_medium" android:textStyle="bold" android:textAllCaps="false"
                android:enabled="false" app:cornerRadius="14dp" app:backgroundTint="#CBD5E1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
