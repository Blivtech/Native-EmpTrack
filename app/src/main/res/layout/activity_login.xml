<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF2F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Gradient header -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gradient">

            <View
                android:layout_width="210dp"
                android:layout_height="210dp"
                android:background="@drawable/bg_circle_white"
                android:alpha="0.10"
                android:layout_gravity="top|end"
                android:layout_marginTop="-70dp"
                android:layout_marginEnd="-70dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:paddingTop="66dp"
                android:paddingBottom="74dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_splash_mark"
                    android:padding="17dp"
                    android:src="@drawable/ic_logo"
                    android:tint="#FFFFFF"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EmpTrack"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/satoshi_medium"
                    android:letterSpacing="-0.01"
                    android:layout_marginTop="14dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign in to your account"
                    android:textColor="#CFE0FF"
                    android:textSize="13.5sp"
                    android:fontFamily="@font/satoshi_medium"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </FrameLayout>

        <!-- Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_login_card"
            android:elevation="14dp"
            android:layout_marginTop="-34dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="26dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome back! 👋"
                android:textSize="23sp"
                android:textStyle="bold"
                android:fontFamily="@font/satoshi_medium"
                android:textColor="#0F172A"
                android:layout_marginBottom="20dp"/>

            <!-- Phone field -->
            <LinearLayout
                android:id="@+id/llPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_field"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_field_chip"
                    android:layout_marginEnd="12dp">
                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_phone"
                        android:tint="#2563EB"/>
                </FrameLayout>

                <EditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:hint="Phone number"
                    android:textColorHint="#94A3B8"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:fontFamily="@font/satoshi_medium"
                    android:inputType="phone"
                    android:imeOptions="actionNext"
                    android:singleLine="true"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvPhoneError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#DC2626"
                android:textSize="12sp"
                android:fontFamily="@font/satoshi_medium"
                android:layout_marginStart="6dp"
                android:layout_marginTop="5dp"
                android:visibility="gone"/>

            <!-- Password field -->
            <LinearLayout
                android:id="@+id/llPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_field"
                android:layout_marginTop="14dp"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_field_chip"
                    android:layout_marginEnd="12dp">
                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_lock"
                        android:tint="#2563EB"/>
                </FrameLayout>

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:hint="Password"
                    android:textColorHint="#94A3B8"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:fontFamily="@font/satoshi_medium"
                    android:inputType="textPassword"
                    android:imeOptions="actionDone"
                    android:singleLine="true"/>

                <ImageView
                    android:id="@+id/ivTogglePassword"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_eye"
                    android:tint="#94A3B8"
                    android:padding="1dp"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvPasswordError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#DC2626"
                android:textSize="12sp"
                android:fontFamily="@font/satoshi_medium"
                android:layout_marginStart="6dp"
                android:layout_marginTop="5dp"
                android:visibility="gone"/>

            <!-- Forgot -->
            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Forgot password?"
                android:textColor="#2563EB"
                android:textStyle="bold"
                android:textSize="13sp"
                android:fontFamily="@font/satoshi_medium"
                android:layout_gravity="end"
                android:layout_marginTop="12dp"
                android:padding="4dp"/>

            <!-- Sign in -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:text="SIGN IN"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                app:backgroundTint="@null"
                android:background="@drawable/bg_btn_primary"
                app:elevation="0dp"/>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                android:indeterminateTint="#2563EB"/>

            <!-- Sign up -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center"
                android:layout_marginTop="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Don't have an account? "
                    android:textColor="#475569"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvGoToSignUp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign up"
                    android:textColor="#2563EB"
                    android:textStyle="bold"
                    android:textSize="14sp"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EmpTrack v1.0  ·  © 2026"
            android:textColor="#94A3B8"
            android:textSize="11.5sp"
            android:layout_gravity="center"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>